# ─── Database ───────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ─── Email (Resend) ────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM=PropertyLoop <noreply@propertyloop.ng>
MAIL_FROM_NAME=PropertyLoop

# ─── Auth / JWT ────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_64_char_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
SESSION_TTL_DAYS=30

# ─── Application ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Extra allowed CORS origins, comma-separated. The built-in list covers the
# main site, admin and team portal; use this for deploy previews or a new
# subdomain without a code change. e.g.
# CORS_EXTRA_ORIGINS=http://localhost:5175,https://team-preview.netlify.app
CORS_EXTRA_ORIGINS=

# Optional. Set to a leading-dot parent domain (e.g. .propertyloop.ng) ONLY once
# the API is served from a subdomain of the site (api.propertyloop.ng). This
# makes the refresh-token cookie first-party so browsers reliably send it on
# /auth/refresh (fixes "logged out on reload"). Leave UNSET while the API is on
# a different site (onrender/railway) — the cookie stays host-only.
# COOKIE_DOMAIN=.propertyloop.ng

# Public origin of THIS backend (no trailing slash), used to build absolute
# watermark-proxy image URLs. e.g. https://api.propertyloop.ng
PUBLIC_API_URL=http://localhost:3000
# Turn the serve-time property-image watermark on/off. When 'true' (and
# PUBLIC_API_URL is set), listing/featured image URLs are served through the
# /api/media/img watermark proxy. Originals in R2 are never modified.
WATERMARK_ENABLED=false

# ─── B2 Cloud Storage ──────────────────────────────────────
B2_KEY_ID=your_b2_key_id
B2_APPLICATION_KEY=your_b2_application_key
B2_BUCKET_NAME=propertyloop

# ─── Paystack ─────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Paystack plan codes (create in Paystack dashboard → Products → Plans)
PAYSTACK_PLAN_STANDARD=PLN_xxxxxxxxxxxxxxx
PAYSTACK_PLAN_PRO=PLN_xxxxxxxxxxxxxxx
