// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing waitlist (pre-launch). Independent of the auth system below.
// ─────────────────────────────────────────────────────────────────────────────

enum UserType {
  REAL_ESTATE_AGENT
  BUILDER
  BUILDING_MATERIALS_SUPPLIER_INSTALLER
  PARTNER_INVESTOR
}

// Email subscribers from the homepage "Coming Soon" mobile-app CTA modal.
// Distinct from WaitlistEntry (which is the original PropertyLoop platform
// waitlist with company / location / role data on every row). This is just
// "tell me when the app is ready".
model AppWaitlistEntry {
  id         String    @id @default(cuid())
  email      String    @unique
  source     String?   // "homepage_cta", "footer", etc. — for future segmentation
  notifiedAt DateTime? // set when we eventually email them about the launch
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// Emails typed into the signup form by people who left before submitting.
// Distinct from AppWaitlistEntry (a launch mailing list someone opted into)
// and from User (no account exists yet). A password is never captured here.
model PartialSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  role        Role?
  // Furthest point reached: "signup" on mobile (one screen), "role" |
  // "signup" on the web wizard.
  step        String?
  // "web" | "mobile" — mirrors User.signupPlatform.
  source      String?
  // Set when this person eventually registers, so follow-up can skip them.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([completedAt, createdAt])
}

model WaitlistEntry {
  id           String    @id @default(uuid())
  first_name   String
  last_name    String
  company_name String?
  location     String?
  phone        String
  email        String    @unique
  type         UserType  @default(REAL_ESTATE_AGENT)
  activated    Boolean   @default(false)
  activatedAt  DateTime?
  created_at   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Featured / Ad properties — admin-curated listings shown on the waitlist hero
// ─────────────────────────────────────────────────────────────────────────────

model FeaturedProperty {
  id           String   @id @default(cuid())
  title        String
  location     String
  priceNaira   BigInt
  priceLabel   String
  type         String   // SALE | RENT | SHORTLET
  propertyType String
  beds         Int      @default(0)
  baths        Int      @default(0)
  sqft         String?
  description  String?
  imageUrls    String[]
  videoUrl     String?
  videoUrls    String[]
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums for the auth & core domain
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  AGENT
  VENDOR
  ADMIN
}

enum ListingType {
  SALE
  RENT
  SHORTLET
}

enum DocumentType {
  C_OF_O
  SURVEY_PLAN
  BUILDING_PERMIT
  RECEIPT
}

enum BookmarkType {
  PROPERTY
  SERVICE
  PRODUCT
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  PAID
}

enum EarningStatus {
  PAID
  PENDING
  PROCESSING
  // Released from escrow into the vendor's in-app balance. Withdrawable, but
  // not yet sent to their bank — the vendor moves it out via "Withdraw".
  AVAILABLE
}

// A vendor's fee is paid out in two halves, so a job funds two earnings:
// DEPOSIT is released when the vendor starts work, FINAL when the buyer
// confirms completion. Jobs created before the split payout carry a single
// FINAL earning worth the whole fee, which still releases on confirmation.
enum EarningKind {
  DEPOSIT
  FINAL
}

enum OrderPaymentMethod {
  CARD
  TRANSFER
  WALLET
}

enum ConversationParticipantRole {
  AGENT
  VENDOR
  HOMEOWNER
  TENANT
  BUYER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  CONVERTED
  LOST
}

enum LeadSource {
  LISTING_PAGE
  AGENT_PROFILE
  PHONE
  EMAIL
  REFERRAL
  OTHER
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  RENTED
  ARCHIVED
}

enum ShortletBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum RentalApplicationStatus {
  PENDING
  DEPOSIT_PAID
  AGREEMENT_SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  NONE
  LOCKED
  RELEASED
  DISPUTED
  REFUNDED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  AGENT
  VENDOR
  LISTING
  USER
  MESSAGE
}

enum SubscriptionTier {
  FREE
  FOUNDING
  STANDARD
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  LAPSED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Core auth & profiles
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role

  // Profile fields shown in the navbar/sidebar across the whole app
  phone     String?
  location  String? // e.g. "Lagos, Nigeria"
  bio       String?
  avatarUrl String?

  // Verification & status
  emailVerifiedAt DateTime?
  // Which client the account was created from ("mobile" | "web"), captured
  // once at signup from X-Client-Platform. Used to route the emailed
  // verification link back to the right place: deep-link into the app for
  // a mobile signup, /login on the website for a web signup. Needed because
  // the link is opened outside either client's own request context.
  signupPlatform  String?
  // isActive doubles as the admin suspension flag (see AdminService.setUserActive) —
  // don't repurpose it for self-deactivation, use deactivatedAt instead so the two
  // can never be confused (a suspended user must not be able to log back in and
  // silently undo their own suspension).
  isActive        Boolean   @default(true)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete from Settings → Danger zone → Delete account (permanent)
  // Self-service pause from Settings → Danger zone → Deactivate account. Logs the
  // user out everywhere; logging back in with the correct password reactivates
  // (clears this) and proceeds normally. Distinct from isActive/admin suspension.
  deactivatedAt DateTime?

  // Referral program — every user (any role) gets a unique shareable code;
  // their personalized link is FRONTEND_URL/onboarding?ref=<code>. When a new
  // signup arrives with a valid code, referredById records who referred them
  // so admin can tally referrals per user for rewards. Nullable because
  // accounts that predate the program get a code minted lazily on first use.
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  // Role-specific 1:1
  buyerProfile      BuyerProfile?
  agentProfile      AgentProfile?
  vendorProfile     VendorProfile?
  vendorBankAccount VendorBankAccount? @relation("VendorBankAccount")
  settings          UserSettings?

  // Auth-token relations
  sessions                Session[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Domain relations
  listings                   Listing[]                 @relation("AgentListings")
  vendorJobs                 VendorJob[]               @relation("VendorJobs")
  vendorEarnings             VendorEarning[]           @relation("VendorEarnings")
  vendorReviews              VendorReview[]            @relation("VendorReviews")
  bookmarks                  Bookmark[]
  vendorBookmarks            Bookmark[]               @relation("VendorBookmarks")
  orders                     Order[]
  sentMessages               Message[]
  conversationsAsParticipant ConversationParticipant[]
  agentLeads                 Lead[]                    @relation("AgentLeads")
  buyerLeads                 Lead[]                    @relation("BuyerLeads")
  agentViewings              Viewing[]                 @relation("AgentViewings")
  buyerViewings              Viewing[]                 @relation("BuyerViewings")
  agentReviewsReceived       AgentReview[]             @relation("AgentReviewsReceived")
  agentReviewsWritten        AgentReview[]             @relation("AgentReviewsWritten")
  vendorBookings             VendorJob[]               @relation("VendorBuyerJobs")
  disputeMessages            JobDisputeMessage[]       @relation("DisputeMessages")
  logbookEntries             LogbookEntry[]            @relation("LogbookOwner")
  shortletBookings           ShortletBooking[]         @relation("BuyerShortlets")
  rentalApplications         RentalApplication[]       @relation("BuyerRentals")
  reports                    Report[]                  @relation("UserReports")
  blocksMade                 BlockedUser[]             @relation("BlocksMade")
  blocksReceived             BlockedUser[]             @relation("BlocksReceived")
  buyerOffers                Offer[]                   @relation("BuyerOffers")
  agentOffers                Offer[]                   @relation("AgentOffers")
  buyerPurchases             PropertyPurchase[]        @relation("BuyerPurchases")
  agentPurchases             PropertyPurchase[]        @relation("AgentPurchases")
  notifications              Notification[]
  pushTokens                 PushToken[]
  vendorServices             VendorService[]           @relation("VendorServices")
  vendorAvailability         VendorAvailability?       @relation("VendorAvailability")
  vendorBlackouts            VendorBlackout[]          @relation("VendorBlackouts")
  kycSubmission              KycSubmission?            @relation("KycSubmission")
  brandAds                   BrandAd[]                 @relation("BrandAds")
  withdrawalRequests         WithdrawalRequest[]       @relation("VendorWithdrawals")

  // Social feed
  feedPosts     FeedPost[]     @relation("FeedPosts")
  feedComments  FeedComment[]  @relation("FeedComments")
  feedLikes     FeedLike[]     @relation("FeedLikes")
  feedSaves     FeedSave[]     @relation("FeedSaves")
  feedPollVotes FeedPollVote[] @relation("FeedPollVotes")
  feedReports   FeedReport[]   @relation("FeedReports")
  following     UserFollow[]   @relation("Following")
  followers     UserFollow[]   @relation("Followers")

  @@index([role])
}

model BuyerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookingFor         String? // "Buy a home" | "Rent a home" | "Shortlet stay" | "Just browsing"
  preferredLocations String? // free text from Onboarding (e.g. "Lekki, Ikoyi, Victoria Island")
  budgetRange        String? // "Under ₦50M" | "₦50M – ₦100M" | "₦100M – ₦200M" | "₦200M+"
  budgetMin          Int? // naira; nullable until set
  budgetMax          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AgentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding fields
  agencyName      String
  // Optional so agents without a CAC/RC number to hand can still register
  // (lowers the signup barrier). Still @unique — Postgres allows many NULLs,
  // so blank agents don't collide, but a real number stays one-per-agent.
  licenseNumber   String? @unique
  businessAddress String

  // Profile + directory fields (Agent interface in src/data/agents.ts)
  yearsExperience Int      @default(0)
  specialty       String[] // e.g. ["Buy", "Rent", "Shortlet", "Commercial"]
  website         String?

  // Public stats — denormalised; recomputed on listing changes
  rating          Float   @default(0)
  listingsCount   Int     @default(0)
  soldRentedCount Int     @default(0)
  verified        Boolean @default(false) // KYC via Smile Identity

  // Subscription
  subscriptionTier              SubscriptionTier?
  subscriptionStatus            SubscriptionStatus?
  subscriptionRenewsAt          DateTime?
  paystackSubscriptionCode      String?  // Paystack subscription code for the active sub
  paystackCustomerCode          String?  // Paystack customer code
  paystackEmailToken            String?  // Required alongside subscription_code to disable a sub via Paystack API

  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorServicePriceMode {
  FIXED
  FROM
}

// Vendor working hours + booking limits (vendor-availability screen).
// `schedule` is a JSON array of { day, on, hours } — hours are free-text
// display strings (e.g. "8:00 AM – 6:00 PM"), so JSON fits better than rows.
model VendorAvailability {
  id                 String  @id @default(cuid())
  vendorUserId       String  @unique
  vendor             User    @relation("VendorAvailability", fields: [vendorUserId], references: [id], onDelete: Cascade)
  acceptingBookings  Boolean @default(true)
  maxJobsPerDay      Int     @default(3)
  responseCommitment String  @default("Within 1 hr")
  schedule           Json // [{ "day": "Monday", "on": true, "hours": "8:00 AM – 6:00 PM" }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Individual days a vendor has blocked off (vendor-blackout screen).
model VendorBlackout {
  id           String   @id @default(cuid())
  vendorUserId String
  vendor       User     @relation("VendorBlackouts", fields: [vendorUserId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now())

  @@unique([vendorUserId, date])
  @@index([vendorUserId])
}

// A discrete service in a vendor's menu (BookService + vendor-menu screens).
// Distinct from VendorProfile.serviceCategory (the vendor's headline trade).
model VendorService {
  id           String                 @id @default(cuid())
  vendorUserId String
  vendor       User                   @relation("VendorServices", fields: [vendorUserId], references: [id], onDelete: Cascade)
  name         String
  description  String
  priceNaira   Int
  priceMode    VendorServicePriceMode @default(FIXED)
  duration     String? // e.g. "2-3 hrs", "Full day"
  active       Boolean                @default(true) // archived = !active
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([vendorUserId])
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding fields
  serviceCategory String // Plumber, Electrician, Builder, etc.
  yearsExperience String // free text in onboarding ("5 years")
  serviceArea     String // e.g. "Lekki, Ajah, Victoria Island"

  // Directory fields (Vendor interface in src/data/vendors.ts)
  priceLabel String? // "From ₦15,000"
  priceNum   Int? // 15000
  website    String? // Vendor's website/portfolio URL

  // Media
  bannerImage      String? // Hero image for directory card
  portfolioImages  String[] // Past work samples
  availableForHire Boolean  @default(true)

  // Stats
  rating    Float    @default(0)
  jobsCount Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorBankAccount {
  id                    String @id @default(cuid())
  vendorUserId          String @unique
  vendor                User   @relation("VendorBankAccount", fields: [vendorUserId], references: [id], onDelete: Cascade)

  accountName           String
  accountNumber         String
  bankCode              String
  bankName              String
  // Optional: payouts are processed manually by an admin (Paystack transfers
  // aren't enabled on our account), so a recipient code is nice-to-have for a
  // future automated flow, not a requirement to save a bank account.
  paystackRecipientCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Vendor withdrawals — manual payouts. Paystack transfers aren't enabled on
// our account, so a withdrawal creates a PENDING request that an admin settles
// by making the bank transfer themselves, then marking it paid (or rejecting,
// which returns the earnings to the vendor's withdrawable balance).
// ─────────────────────────────────────────────────────────────────────────────

enum WithdrawalStatus {
  PENDING // vendor requested — waiting on an admin to transfer manually
  PAID // admin transferred the money and confirmed
  REJECTED // admin declined — earnings returned to AVAILABLE
}

model WithdrawalRequest {
  id           String @id @default(cuid())
  vendorUserId String
  vendor       User   @relation("VendorWithdrawals", fields: [vendorUserId], references: [id], onDelete: Cascade)

  amountNaira Int
  status      WithdrawalStatus @default(PENDING)

  // Snapshot of the payout account at request time — this is the account the
  // admin transfers to, even if the vendor edits their bank details later.
  bankName      String
  accountNumber String
  accountName   String

  adminNote   String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  earnings VendorEarning[]

  @@index([vendorUserId])
  @@index([status])
}

model SubscriptionPayment {
  id              String @id @default(cuid())
  agentProfileId  String
  agentProfile    AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  tier            SubscriptionTier
  amountKobo      Int
  paystackRef     String   @unique  // Paystack transaction reference
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status          String   // "success" | "failed" | "pending"

  createdAt DateTime @default(now())

  @@index([agentProfileId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notifications (5 toggles in Settings.tsx)
  notifEmail       Boolean @default(true)
  notifSms         Boolean @default(true)
  notifMessages    Boolean @default(true)
  notifPriceAlerts Boolean @default(true)
  notifMarketing   Boolean @default(false)

  // Privacy
  profileVisible Boolean @default(true)
  shareActivity  Boolean @default(false)

  // Preferences
  language String @default("English")
  currency String @default("NGN")

  // Security
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth tokens — sessions + rotating refresh + verification + reset
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Opaque session token (hashed at rest)
  tokenHash String @unique

  // Device metadata for the Settings "active devices" UI
  userAgent   String?
  ipAddress   String?
  deviceLabel String? // e.g. "Chrome on Windows"

  // Lifecycle
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  // Rotation chain — when this token is used, a new one is issued and this one
  // is marked replaced. Reuse of a replaced token = stolen token = revoke chain.
  replacedById String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Frontend ForgotPassword.tsx uses a 6-digit code flow → store hash of code
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain — listings, products, bookmarks, conversations, orders, vendor work
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id      String @id @default(cuid())
  agentId String
  agent   User   @relation("AgentListings", fields: [agentId], references: [id], onDelete: Cascade)

  // From Listing interface in src/data/listings.ts
  title        String
  slug         String      @unique
  type         ListingType
  propertyType String // "Flat / Apartment", "Detached House", etc.
  priceNaira   BigInt // store as integer naira (BigInt — Banana Island can hit ₦5-10B which overflows int4)
  priceLabel   String // "₦65,000,000" — keep frontend's formatted string for backwards compat
  period       String? // "/year" for rentals, "/night" for shortlets
  address      String
  location     String // "Lekki, Lagos"
  beds         Int
  baths        Int
  sqft         String // free-text, matches frontend ("2,400")
  yearBuilt    String?
  description  String
  features     String[] // ["24hr Power", "Swimming Pool", ...]
  coverImage   String
  images       String[]
  rating       Float         @default(0)
  verified     Boolean       @default(false)
  status       ListingStatus @default(PENDING_REVIEW)
  viewsCount   Int           @default(0)
  featured     Boolean       @default(false) // Pro "Featured placement" — top of search
  openToOffers Boolean       @default(false) // "Accept offers" — buyers can submit offers
  // Video tour fields (matches data/videos.ts VideoListing interface)
  virtualTourUrl String? // YouTube embed URL
  videoUrl       String? // Property video URL (upload or external)
  videoUrls      String[] // Multiple video URLs
  videoThumbnail String? // Thumbnail image for video card
  videoDuration  String? // e.g. "2:34"
  videoViewCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents         ListingDocument[]
  bookmarkedBy      Bookmark[]        @relation("ListingBookmarks")
  leads             Lead[]
  viewings          Viewing[]
  shortletBookings  ShortletBooking[]
  rentalApplications RentalApplication[]
  logbookEntries LogbookEntry[]
  priceHistory   ListingPriceHistory[]
  offers         Offer[]
  purchases      PropertyPurchase[]
  feedShares     FeedPost[]            @relation("FeedListingShares")

  @@index([agentId])
  @@index([type])
  @@index([location])
  @@index([status])
}

model ListingDocument {
  id        String       @id @default(cuid())
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String // "Certificate of Occupancy"
  type      DocumentType
  url       String? // Public URL of the uploaded file in R2
  verified  Boolean      @default(false)
  date      String // matches frontend's free-text "Sep 2022"
  createdAt DateTime     @default(now())

  @@index([listingId])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  supplier     String
  category     String // "Cement & Concrete", "Roofing", ...
  description  String
  priceNaira   Int
  priceLabel   String
  unit         String // "bag", "sqm", "litre"
  minOrder     String // "10 bags"
  location     String
  phone        String
  coverImage   String
  images       String[]
  specs        Json // [{label, value}, ...] — flexible per product
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  verified     Boolean  @default(false)
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookmarkedBy Bookmark[]  @relation("ProductBookmarks")
  orderItems   OrderItem[]

  @@index([category])
}

model Bookmark {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   BookmarkType

  // Optional typed FKs — only one is set per row, depending on `type`
  listingId    String?
  listing      Listing? @relation("ListingBookmarks", fields: [listingId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation("ProductBookmarks", fields: [productId], references: [id], onDelete: Cascade)
  // For "service" bookmarks, points at a vendor User row
  vendorUserId String?
  vendor       User?    @relation("VendorBookmarks", fields: [vendorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, type, listingId, productId, vendorUserId])
  @@index([userId])
}

model Conversation {
  id String @id @default(cuid())

  // Optional context — what the conversation is about
  listingId String?
  productId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String                      @id @default(cuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationParticipantRole
  unreadCount    Int                         @default(0)
  // When this participant last opened/read the conversation. Drives read
  // receipts: a message counts as "read" once every other participant's
  // lastReadAt is past its createdAt.
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  text           String
  attachmentUrls String[]
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Order {
  id String @id @default(cuid())

  // Human-readable order number shown in OrderConfirmation.tsx ("MAT-...")
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery details (Checkout.tsx)
  recipientName String
  phone         String
  address       String
  city          String
  notes         String?

  // Money — naira-int to match frontend math
  subtotal    Int
  deliveryFee Int
  serviceFee  Int
  total       Int
  payMethod   OrderPaymentMethod

  placedAt DateTime @default(now())

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot the product fields at order time so they don't change if Product is edited
  name       String
  supplier   String
  image      String
  priceLabel String
  unit       String
  unitPrice  Int // naira at time of order
  quantity   Int

  @@index([orderId])
}

// Vendor work (matches src/data/vendor-dashboard.ts interfaces)

model VendorJob {
  id           String @id @default(cuid())
  vendorUserId String
  vendor       User   @relation("VendorJobs", fields: [vendorUserId], references: [id], onDelete: Restrict)

  // Buyer who booked the job (null for guest bookings)
  buyerUserId String?
  buyer       User?   @relation("VendorBuyerJobs", fields: [buyerUserId], references: [id], onDelete: SetNull)

  title        String
  clientName   String
  clientAvatar String?
  clientPhone  String
  clientEmail  String?
  address      String
  category     String
  status       JobStatus @default(PENDING)
  amount       Int // naira — legacy, same as vendorFee
  description  String
  scheduledFor DateTime?

  // Booking details (from BookService.tsx)
  negotiationNotes String? // Free-text negotiation notes between buyer & vendor
  preferredTime    String? // e.g. "Morning", "Afternoon", "Evening"
  attachments      String[] // Image/video URLs uploaded by buyer at booking time

  // Escrow (placeholder until Paystack wiring)
  escrowId      String?      @unique
  escrowStatus  EscrowStatus @default(NONE)
  escrowAmount  Int          @default(0) // what the buyer pays = the vendor's listed price (no markup)
  vendorFee     Int          @default(0) // vendor's net take = 90% of the price
  platformFee   Int          @default(0) // 10% PropertyLoop commission, deducted from the vendor's cut
  paymentMethod String?

  // The vendor fee is paid in two halves: depositAmount lands in their balance
  // when they start work, finalAmount when the buyer confirms. Invariant:
  // depositAmount + finalAmount = vendorFee. Jobs predating the split payout
  // have depositAmount = 0 and finalAmount = vendorFee.
  depositAmount     Int       @default(0)
  finalAmount       Int       @default(0)
  depositReleasedAt DateTime?

  // Completion & dispute
  completionProofImages String[]
  completionNotes       String?
  completedAt           DateTime?
  confirmedAt           DateTime?
  disputeReason         String?
  disputedAt            DateTime?
  refundedAt            DateTime?

  // Paystack integration
  escrowPaidAt  DateTime? // when webhook confirms charge.success
  transferCode  String?   // Paystack transfer code after release

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earnings        VendorEarning[]
  reviews         VendorReview[]
  logbookEntry    LogbookEntry?
  disputeMessages JobDisputeMessage[]

  @@index([vendorUserId])
  @@index([buyerUserId])
  @@index([status])
  @@index([escrowStatus])
  @@index([transferCode])
}

// Threaded conversation on a disputed VendorJob. The customer raises the
// dispute (first CUSTOMER message + a SYSTEM mediation note), the vendor
// responds with evidence, and admins can weigh in — all scoped to one job.
enum DisputeAuthorRole {
  CUSTOMER
  VENDOR
  SYSTEM
  ADMIN
}

model JobDisputeMessage {
  id           String            @id @default(cuid())
  jobId        String
  job          VendorJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Null for SYSTEM messages.
  senderUserId String?
  sender       User?             @relation("DisputeMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  role         DisputeAuthorRole
  body         String
  attachments  String[]
  createdAt    DateTime          @default(now())

  @@index([jobId])
}

model VendorEarning {
  id           String    @id @default(cuid())
  vendorUserId String
  vendor       User      @relation("VendorEarnings", fields: [vendorUserId], references: [id], onDelete: Cascade)
  jobId        String
  job          VendorJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  jobTitle   String
  clientName String
  amount     Int
  // Which half of the fee this row represents. See EarningKind.
  kind       EarningKind   @default(FINAL)
  status     EarningStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  // Set while the earning is inside a manual withdrawal (PROCESSING). Cleared
  // if the request is rejected (earning returns to AVAILABLE).
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  // One row per half, which keeps the release/refund upserts idempotent.
  @@unique([jobId, kind])
  @@index([vendorUserId])
  @@index([jobId])
  @@index([withdrawalRequestId])
}

model VendorReview {
  id           String     @id @default(cuid())
  vendorUserId String
  vendor       User       @relation("VendorReviews", fields: [vendorUserId], references: [id], onDelete: Cascade)
  jobId        String?
  job          VendorJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  clientName   String
  clientAvatar String?
  rating       Int // 1–5
  comment      String
  jobTitle     String
  reply        String? // public reply from the vendor
  repliedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([vendorUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent leads, viewings, and reviews
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id        String @id @default(cuid())
  // Agent who owns the lead (the listing's agent)
  agentId   String
  agent     User   @relation("AgentLeads", fields: [agentId], references: [id], onDelete: Cascade)
  // Listing the lead is interested in
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Optional buyer user (null for guest enquiries)
  buyerUserId String?
  buyer       User?   @relation("BuyerLeads", fields: [buyerUserId], references: [id], onDelete: SetNull)

  // Snapshotted contact info (in case the buyer is a guest)
  name    String
  email   String?
  phone   String
  message String?

  status      LeadStatus @default(NEW)
  source      LeadSource @default(LISTING_PAGE)
  // Free-text agent notes
  notes       String?
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([listingId])
  @@index([status])
}

model Viewing {
  id        String @id @default(cuid())
  agentId   String
  agent     User   @relation("AgentViewings", fields: [agentId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerViewings", fields: [buyerUserId], references: [id], onDelete: SetNull)

  // Snapshotted contact info
  clientName  String
  clientPhone String
  clientEmail String?

  scheduledFor DateTime
  status       ViewingStatus @default(PENDING)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([listingId])
  @@index([scheduledFor])
  @@index([status])
}

model AgentReview {
  id String @id @default(cuid())
  // Agent being reviewed
  agentUserId String
  agent       User   @relation("AgentReviewsReceived", fields: [agentUserId], references: [id], onDelete: Cascade)
  // Reviewer (optional — guest reviews allowed)
  reviewerUserId String?
  reviewer       User?   @relation("AgentReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  // Snapshotted reviewer name
  reviewerName String

  rating  Int    // 1-5
  comment String

  createdAt DateTime @default(now())

  @@index([agentUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Blog
// ─────────────────────────────────────────────────────────────────────────────

enum BlogCategory {
  MARKET_INSIGHTS
  GUIDES
  PRODUCT_UPDATES
  AGENT_TIPS
}

model BlogPost {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  excerpt   String
  content   String[] // Array of paragraphs / markdown blocks
  category  BlogCategory
  image     String // Cover image URL
  author    String
  avatar    String? // Author avatar URL
  readTime  String // e.g. "5 min read"
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category])
  @@index([published])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property Logbook — permanent maintenance history per property
// ─────────────────────────────────────────────────────────────────────────────

model LogbookEntry {
  id        String @id @default(cuid())
  // Property reference (nullable for vendor jobs not yet linked to a property)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Vendor job that generated this entry (auto-logged on escrow release)
  jobId     String?  @unique
  job       VendorJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Owner at time of entry
  ownerUserId String
  owner       User @relation("LogbookOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Entry details (snapshot from completed VendorJob)
  category    String // Plumbing, Electrical, etc.
  title       String // Job title / summary
  description String?
  vendorName  String
  vendorId    String?
  cost        Int // naira
  completedAt DateTime
  verified    Boolean @default(false) // true when confirmed via escrow

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([ownerUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Listing price history — recorded on each price update by agent
// ─────────────────────────────────────────────────────────────────────────────

model ListingPriceHistory {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice  BigInt
  newPrice  BigInt
  changedAt DateTime @default(now())

  @@index([listingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Partners — displayed on homepage partner logo section
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id       String  @id @default(cuid())
  name     String
  logoUrl  String
  website  String?
  sortOrder Int    @default(0)
  active   Boolean @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Shortlet bookings & rental applications (buyer-side)
// ─────────────────────────────────────────────────────────────────────────────

model ShortletBooking {
  id          String @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerShortlets", fields: [buyerUserId], references: [id], onDelete: SetNull)

  guestName  String
  guestPhone String
  guestEmail String?
  guests     Int

  checkIn  DateTime
  checkOut DateTime
  nights   Int

  subtotal   Int // pricePerNight * nights
  serviceFee Int // 10%
  total      Int

  paymentMethod String?
  escrowId      String?              @unique
  escrowStatus  EscrowStatus         @default(NONE)
  status        ShortletBookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([buyerUserId])
  @@index([status])
}

model RentalApplication {
  id          String @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerRentals", fields: [buyerUserId], references: [id], onDelete: SetNull)

  applicantName  String
  applicantPhone String
  applicantEmail String?

  deposit       Int // annual rent
  agencyFee     Int // 10%
  legalFee      Int
  serviceFee    Int // 5%
  total         Int

  leaseDuration String   // "12 months"
  startDate     DateTime

  paymentMethod String?
  escrowId      String?                  @unique
  escrowStatus  EscrowStatus             @default(NONE)
  status        RentalApplicationStatus  @default(PENDING)

  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listingId])
  @@index([buyerUserId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports (user reports of agents, vendors, listings)
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id         String           @id @default(cuid())
  reporterId String?
  reporter   User?            @relation("UserReports", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType ReportTargetType
  targetId   String
  reason     String

  status     ReportStatus @default(PENDING)
  adminNote  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

// Blocking another user is instant and client-enforced: it hides that user's
// content from the blocker (conversation, listings, profile) and stops them
// from messaging the blocker again. Also creates a Report (targetType USER)
// so the team reviews the blocked account — App Store guideline 1.2 requires
// blocking to notify the developer of the inappropriate content, not just
// silently hide it from the blocker.
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property purchase offers + negotiation + purchase progress
//
// Agents NEVER collect money on the platform — these flows are negotiation +
// status tracking only. Any sale funds are settled off-platform between buyer
// and seller (the app copy says "Non-binding · you and the seller settle
// directly"). No Paystack charge/transfer is involved here.
// ─────────────────────────────────────────────────────────────────────────────

enum OfferStatus {
  PENDING // submitted, awaiting the agent's response
  COUNTERED // a counter is on the table (made by agent or buyer)
  ACCEPTED // both sides agreed → a PropertyPurchase is created
  DECLINED // rejected by the agent
  WITHDRAWN // pulled by the buyer
  EXPIRED // deadline passed with no agreement
}

enum OfferFinancing {
  CASH
  OWN_FINANCING
}

enum OfferActor {
  BUYER
  AGENT
}

enum OfferEventType {
  OFFER // initial offer
  COUNTER // a counter-offer
  ACCEPT
  DECLINE
  WITHDRAW
  EXPIRE
}

enum PurchaseStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseStepState {
  DONE
  ACTIVE
  TODO
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId   String // denormalised from the listing for fast agent-side queries
  agent     User    @relation("AgentOffers", fields: [agentId], references: [id], onDelete: Cascade)

  // Buyer's original terms
  amountNaira         BigInt // BigInt to match Listing.priceNaira (prices can exceed int4)
  financing           OfferFinancing @default(CASH)
  note                String?
  closeDate           DateTime?
  subjectToInspection Boolean        @default(true)

  // Live negotiation state
  status             OfferStatus @default(PENDING)
  currentAmountNaira BigInt // latest figure on the table (initial offer or most recent counter)
  lastActor          OfferActor  @default(BUYER) // who made the last move
  expiresAt          DateTime? // optional buyer-set deadline for a response

  events   OfferEvent[]
  purchase PropertyPurchase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([agentId])
  @@index([listingId])
  @@index([status])
}

model OfferEvent {
  id          String         @id @default(cuid())
  offerId     String
  offer       Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  type        OfferEventType
  actor       OfferActor
  amountNaira BigInt? // present for OFFER and COUNTER events
  note        String?
  createdAt   DateTime       @default(now())

  @@index([offerId])
}

model PropertyPurchase {
  id        String  @id @default(cuid())
  offerId   String  @unique
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User    @relation("AgentPurchases", fields: [agentId], references: [id], onDelete: Cascade)

  agreedAmountNaira BigInt
  status            PurchaseStatus @default(IN_PROGRESS)

  steps PurchaseStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([agentId])
}

model PurchaseStep {
  id          String            @id @default(cuid())
  purchaseId  String
  purchase    PropertyPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  order       Int
  key         String // stable identifier, e.g. "OFFER_ACCEPTED", "TITLE_SEARCH"
  title       String
  detail      String
  state       PurchaseStepState @default(TODO)
  eta         String?
  completedAt DateTime?

  @@index([purchaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications — in-app feed + Expo push
//
// `type` is a free-text key (see notification-types.ts) rather than an enum so
// new notification kinds can ship without a schema migration. `data` carries a
// small JSON payload the mobile app uses to deep-link (e.g. { offerId }).
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // e.g. "OFFER_RECEIVED", "OFFER_ACCEPTED", "JOB_REQUEST"
  title String
  body  String
  data  Json? // deep-link payload, e.g. { "offerId": "..." }

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String   @unique // Expo push token (ExponentPushToken[...])
  platform   String? // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity / KYC verification (interim: doc upload + admin approval).
// Smile Identity integration can replace the manual review later.
// ─────────────────────────────────────────────────────────────────────────────

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model KycSubmission {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("KycSubmission", fields: [userId], references: [id], onDelete: Cascade)

  fullName       String?
  documentType   String // "NIN" | "Passport" | "Drivers License" | "Voters Card" | "CAC"
  documentNumber String?
  documentUrls   String[] // uploaded ID images / PDFs
  selfieUrl      String?

  status          KycStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social feed — community posts shared between agents, vendors, buyers,
// sellers and developers. Post types mirror the composer chips on the web
// feed (update / market insight / completed project / property tip /
// industry news / poll / listing share).
// ─────────────────────────────────────────────────────────────────────────────

enum FeedPostType {
  UPDATE
  INSIGHT
  PROJECT
  TIP
  NEWS
  POLL
  LISTING
}

model FeedPost {
  id       String       @id @default(cuid())
  authorId String
  author   User         @relation("FeedPosts", fields: [authorId], references: [id], onDelete: Cascade)
  type     FeedPostType @default(UPDATE)
  body     String

  // Photo posts (R2 URLs, up to 4 rendered as a collage)
  images String[] @default([])

  // Listing share — embeds one of the author's listings as a card
  listingId String?
  listing   Listing? @relation("FeedListingShares", fields: [listingId], references: [id], onDelete: SetNull)

  // Market-insight card (all optional; bars are relative heights 0-100)
  insightMetric String?
  insightPeriod String?
  insightDelta  String?
  insightBars   Int[]   @default([])

  // Completed-project card
  projectName     String?
  projectLocation String?
  projectUnits    String?

  // Poll
  pollEndsAt  DateTime?
  pollOptions FeedPollOption[]

  likes    FeedLike[]
  saves    FeedSave[]
  comments FeedComment[]
  reports  FeedReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([authorId])
  @@index([type])
}

model FeedReport {
  id         String       @id @default(cuid())
  postId     String
  post       FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?        @relation("FeedReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String?
  status     ReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([status])
}

model FeedPollOption {
  id     String         @id @default(cuid())
  postId String
  post   FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  text   String
  order  Int            @default(0)
  votes  FeedPollVote[]

  @@index([postId])
}

model FeedPollVote {
  id       String         @id @default(cuid())
  optionId String
  option   FeedPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  postId   String // denormalised so one-vote-per-post is enforceable
  userId   String
  user     User           @relation("FeedPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model FeedLike {
  id     String   @id @default(cuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation("FeedLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedSave {
  id     String   @id @default(cuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation("FeedSaves", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedComment {
  id       String        @id @default(cuid())
  postId   String
  post     FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("FeedComments", fields: [authorId], references: [id], onDelete: Cascade)
  body     String
  parentId String?
  parent   FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  FeedComment[] @relation("FeedCommentReplies")

  createdAt DateTime @default(now())

  @@index([postId])
}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Brand advertising — external brands pay a flat fee to run a creative in a
// placement slot for a fixed window. Self-serve: a brand signs up as a normal
// user, creates the ad, pays via Paystack (web checkout — never in the iOS
// app), and the ad goes live after admin review.
// ─────────────────────────────────────────────────────────────────────────────

enum AdPlacement {
  SPLASH // full-screen interstitial on app open
  HOME_BANNER // banner at the top of Home
  HOME_FEED // sponsored card inside the listings grid
  SEARCH_INLINE // inline card in search results
}

enum AdStatus {
  DRAFT // created, not paid yet
  PENDING_REVIEW // paid, waiting on admin approval
  ACTIVE // approved — serves while inside its run window
  PAUSED // temporarily pulled by admin
  REJECTED // failed review (payment refunded off-platform)
  EXPIRED // run window ended
}

model BrandAd {
  id          String  @id @default(cuid())
  ownerUserId String
  owner       User    @relation("BrandAds", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Who the advertiser is
  brandName    String
  contactEmail String
  contactPhone String?

  // The creative
  imageUrl String
  headline String
  body     String?
  ctaLabel String  @default("Learn more")
  ctaUrl   String

  // Where + when it runs
  placement AdPlacement
  status    AdStatus    @default(DRAFT)
  priority  Int         @default(0) // rotation weight when a slot has several ads
  startAt   DateTime
  endAt     DateTime
  weeks     Int         @default(1)

  // The money (flat fee, computed server-side from placement × weeks)
  amountNaira Int
  paymentRef  String?   @unique
  paidAt      DateTime?

  // Reporting back to the brand
  impressions Int @default(0)
  clicks      Int @default(0)

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status])
  @@index([ownerUserId])
  @@index([status])
}
