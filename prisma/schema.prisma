// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────────
// Marketing waitlist (pre-launch). Independent of the auth system below.
// ─────────────────────────────────────────────────────────────────────────────

enum UserType {
  REAL_ESTATE_AGENT
  BUILDER
  BUILDING_MATERIALS_SUPPLIER_INSTALLER
  PARTNER_INVESTOR
}

// Email subscribers from the homepage "Coming Soon" mobile-app CTA modal.
// Distinct from WaitlistEntry (which is the original PropertyLoop platform
// waitlist with company / location / role data on every row). This is just
// "tell me when the app is ready".
model AppWaitlistEntry {
  id         String    @id @default(cuid())
  email      String    @unique
  source     String? // "homepage_cta", "footer", etc. — for future segmentation
  notifiedAt DateTime? // set when we eventually email them about the launch
  createdAt  DateTime  @default(now())

  @@index([createdAt])
}

// Emails typed into the signup form by people who left before submitting.
// Distinct from AppWaitlistEntry (a launch mailing list someone opted into)
// and from User (no account exists yet). A password is never captured here.
model PartialSignup {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String?
  phone       String?
  role        Role?
  // Furthest point reached: "signup" on mobile (one screen), "role" |
  // "signup" on the web wizard.
  step        String?
  // "web" | "mobile" — mirrors User.signupPlatform.
  source      String?
  // Set when this person eventually registers, so follow-up can skip them.
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([completedAt, createdAt])
}

model WaitlistEntry {
  id           String    @id @default(uuid())
  first_name   String
  last_name    String
  company_name String?
  location     String?
  phone        String
  email        String    @unique
  type         UserType  @default(REAL_ESTATE_AGENT)
  activated    Boolean   @default(false)
  activatedAt  DateTime?
  created_at   DateTime  @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Featured / Ad properties — admin-curated listings shown on the waitlist hero
// ─────────────────────────────────────────────────────────────────────────────

model FeaturedProperty {
  id           String   @id @default(cuid())
  title        String
  location     String
  priceNaira   BigInt
  priceLabel   String
  type         String // SALE | RENT | SHORTLET
  propertyType String
  beds         Int      @default(0)
  baths        Int      @default(0)
  sqft         String?
  description  String?
  imageUrls    String[]
  videoUrl     String?
  videoUrls    String[]
  displayOrder Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active, displayOrder, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums for the auth & core domain
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  BUYER
  AGENT
  VENDOR
  ADMIN
}

/// Who a listing actually belongs to.
///
/// Everything staff post from the team portal is HOUSE — PropertyLoop's own
/// stock, secured through a mandate — and that is the inventory agent
/// partners are given to sell. AGENT_OWN is a listing an individual agent
/// brought and controls themselves. The distinction did not exist before:
/// every listing simply had an agentId, so there was no way to ask "what is
/// ours?" — which is the first question a partner programme has to answer.
enum ListingOwnership {
  AGENT_OWN
  HOUSE
}

enum ListingType {
  SALE
  RENT
  SHORTLET
}

enum DocumentType {
  C_OF_O
  SURVEY_PLAN
  BUILDING_PERMIT
  RECEIPT
}

enum BookmarkType {
  PROPERTY
  SERVICE
  PRODUCT
}

enum JobStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  PAID
}

enum EarningStatus {
  PAID
  PENDING
  PROCESSING
  // Released from escrow into the vendor's in-app balance. Withdrawable, but
  // not yet sent to their bank — the vendor moves it out via "Withdraw".
  AVAILABLE
}

// A vendor's fee is paid out in two halves, so a job funds two earnings:
// DEPOSIT is released when the vendor starts work, FINAL when the buyer
// confirms completion. Jobs created before the split payout carry a single
// FINAL earning worth the whole fee, which still releases on confirmation.
enum EarningKind {
  DEPOSIT
  FINAL
}

enum OrderPaymentMethod {
  CARD
  TRANSFER
  WALLET
}

enum ConversationParticipantRole {
  AGENT
  VENDOR
  HOMEOWNER
  TENANT
  BUYER
  ADMIN
}

enum LeadStatus {
  NEW
  CONTACTED
  VIEWING_SCHEDULED
  NEGOTIATING
  CONVERTED
  LOST
}

enum LeadSource {
  LISTING_PAGE
  AGENT_PROFILE
  PHONE
  EMAIL
  REFERRAL
  /// Introduced by an agent partner working house inventory.
  PARTNER
  OTHER
}

enum ViewingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ListingStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  SOLD
  RENTED
  ARCHIVED
}

enum ShortletBookingStatus {
  PENDING
  CONFIRMED
  CHECKED_IN
  COMPLETED
  CANCELLED
}

enum RentalApplicationStatus {
  PENDING
  DEPOSIT_PAID
  AGREEMENT_SIGNED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum EscrowStatus {
  NONE
  LOCKED
  RELEASED
  DISPUTED
  REFUNDED
}

enum ReportStatus {
  PENDING
  REVIEWED
  RESOLVED
  DISMISSED
}

enum ReportTargetType {
  AGENT
  VENDOR
  LISTING
  USER
  MESSAGE
}

enum SubscriptionTier {
  FREE
  FOUNDING
  STANDARD
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  LAPSED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// Core auth & profiles
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  role         Role

  // Profile fields shown in the navbar/sidebar across the whole app
  phone     String?
  location  String? // e.g. "Lagos, Nigeria"
  bio       String?
  avatarUrl String?

  // Verification & status
  emailVerifiedAt DateTime?
  // Which client the account was created from ("mobile" | "web"), captured
  // once at signup from X-Client-Platform. Used to route the emailed
  // verification link back to the right place: deep-link into the app for
  // a mobile signup, /login on the website for a web signup. Needed because
  // the link is opened outside either client's own request context.
  signupPlatform  String?
  // isActive doubles as the admin suspension flag (see AdminService.setUserActive) —
  // don't repurpose it for self-deactivation, use deactivatedAt instead so the two
  // can never be confused (a suspended user must not be able to log back in and
  // silently undo their own suspension).
  isActive        Boolean   @default(true)

  // Timestamps
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime? // soft delete from Settings → Danger zone → Delete account (permanent)
  // Self-service pause from Settings → Danger zone → Deactivate account. Logs the
  // user out everywhere; logging back in with the correct password reactivates
  // (clears this) and proceeds normally. Distinct from isActive/admin suspension.
  deactivatedAt DateTime?

  // Referral program — every user (any role) gets a unique shareable code;
  // their personalized link is FRONTEND_URL/onboarding?ref=<code>. When a new
  // signup arrives with a valid code, referredById records who referred them
  // so admin can tally referrals per user for rewards. Nullable because
  // accounts that predate the program get a code minted lazily on first use.
  referralCode String? @unique
  referredById String?
  referredBy   User?   @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    User[]  @relation("UserReferrals")

  // Role-specific 1:1
  buyerProfile      BuyerProfile?
  agentProfile      AgentProfile?
  vendorProfile     VendorProfile?
  vendorBankAccount VendorBankAccount? @relation("VendorBankAccount")
  settings          UserSettings?

  // Auth-token relations
  sessions                Session[]
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]

  // Domain relations
  listings                   Listing[]                 @relation("AgentListings")
  vendorJobs                 VendorJob[]               @relation("VendorJobs")
  vendorEarnings             VendorEarning[]           @relation("VendorEarnings")
  vendorReviews              VendorReview[]            @relation("VendorReviews")
  bookmarks                  Bookmark[]
  vendorBookmarks            Bookmark[]                @relation("VendorBookmarks")
  orders                     Order[]
  ownedStores                MarketplaceStore[]        @relation("OwnedStores")
  marketplaceOrders          MarketplaceOrder[]        @relation("MarketplaceOrders")
  marketplaceDisputesRaised  MarketplaceDispute[]      @relation("MarketplaceDisputesRaised")
  sentMessages               Message[]
  conversationsAsParticipant ConversationParticipant[]
  agentLeads                 Lead[]                    @relation("AgentLeads")
  buyerLeads                 Lead[]                    @relation("BuyerLeads")
  agentViewings              Viewing[]                 @relation("AgentViewings")
  buyerViewings              Viewing[]                 @relation("BuyerViewings")
  agentReviewsReceived       AgentReview[]             @relation("AgentReviewsReceived")
  agentReviewsWritten        AgentReview[]             @relation("AgentReviewsWritten")
  vendorBookings             VendorJob[]               @relation("VendorBuyerJobs")
  disputeMessages            JobDisputeMessage[]       @relation("DisputeMessages")
  logbookEntries             LogbookEntry[]            @relation("LogbookOwner")
  shortletBookings           ShortletBooking[]         @relation("BuyerShortlets")
  rentalApplications         RentalApplication[]       @relation("BuyerRentals")
  reports                    Report[]                  @relation("UserReports")
  blocksMade                 BlockedUser[]             @relation("BlocksMade")
  blocksReceived             BlockedUser[]             @relation("BlocksReceived")
  buyerOffers                Offer[]                   @relation("BuyerOffers")
  agentOffers                Offer[]                   @relation("AgentOffers")
  buyerPurchases             PropertyPurchase[]        @relation("BuyerPurchases")
  agentPurchases             PropertyPurchase[]        @relation("AgentPurchases")
  notifications              Notification[]
  pushTokens                 PushToken[]
  webPushSubscriptions       WebPushSubscription[]
  vendorServices             VendorService[]           @relation("VendorServices")
  vendorAvailability         VendorAvailability?       @relation("VendorAvailability")
  vendorBlackouts            VendorBlackout[]          @relation("VendorBlackouts")
  kycSubmission              KycSubmission?            @relation("KycSubmission")
  brandAds                   BrandAd[]                 @relation("BrandAds")
  withdrawalRequests         WithdrawalRequest[]       @relation("VendorWithdrawals")

  // Social feed
  feedPosts     FeedPost[]     @relation("FeedPosts")
  feedComments  FeedComment[]  @relation("FeedComments")
  feedLikes     FeedLike[]     @relation("FeedLikes")
  feedSaves     FeedSave[]     @relation("FeedSaves")
  feedPollVotes FeedPollVote[] @relation("FeedPollVotes")
  feedReports   FeedReport[]   @relation("FeedReports")
  following     UserFollow[]   @relation("Following")
  followers     UserFollow[]   @relation("Followers")

  // Team portal. Present only for PropertyLoop staff — this record, not the
  // Role enum, is what makes somebody staff.
  staffProfile StaffProfile? @relation("StaffProfile")
  // Agent Partner Programme. Present for realtors who registered through
  // /realtors/partners — they are ordinary AGENT users with this attached.
  agentPartner AgentPartner? @relation("AgentPartner")

  @@index([role])
}

model BuyerProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lookingFor         String? // "Buy a home" | "Rent a home" | "Shortlet stay" | "Just browsing"
  preferredLocations String? // free text from Onboarding (e.g. "Lekki, Ikoyi, Victoria Island")
  budgetRange        String? // "Under ₦50M" | "₦50M – ₦100M" | "₦100M – ₦200M" | "₦200M+"
  budgetMin          Int? // naira; nullable until set
  budgetMax          Int?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AgentProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding fields
  agencyName      String
  // Optional so agents without a CAC/RC number to hand can still register
  // (lowers the signup barrier). Still @unique — Postgres allows many NULLs,
  // so blank agents don't collide, but a real number stays one-per-agent.
  licenseNumber   String? @unique
  businessAddress String

  // Profile + directory fields (Agent interface in src/data/agents.ts)
  yearsExperience Int      @default(0)
  specialty       String[] // e.g. ["Buy", "Rent", "Shortlet", "Commercial"]
  website         String?

  // Public stats — denormalised; recomputed on listing changes
  rating          Float   @default(0)
  listingsCount   Int     @default(0)
  soldRentedCount Int     @default(0)
  verified        Boolean @default(false) // KYC via Smile Identity

  // Subscription
  subscriptionTier         SubscriptionTier?
  subscriptionStatus       SubscriptionStatus?
  subscriptionRenewsAt     DateTime?
  paystackSubscriptionCode String? // Paystack subscription code for the active sub
  paystackCustomerCode     String? // Paystack customer code
  paystackEmailToken       String? // Required alongside subscription_code to disable a sub via Paystack API

  subscriptionPayments SubscriptionPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VendorServicePriceMode {
  FIXED
  FROM
}

// Vendor working hours + booking limits (vendor-availability screen).
// `schedule` is a JSON array of { day, on, hours } — hours are free-text
// display strings (e.g. "8:00 AM – 6:00 PM"), so JSON fits better than rows.
model VendorAvailability {
  id                 String  @id @default(cuid())
  vendorUserId       String  @unique
  vendor             User    @relation("VendorAvailability", fields: [vendorUserId], references: [id], onDelete: Cascade)
  acceptingBookings  Boolean @default(true)
  maxJobsPerDay      Int     @default(3)
  responseCommitment String  @default("Within 1 hr")
  schedule           Json // [{ "day": "Monday", "on": true, "hours": "8:00 AM – 6:00 PM" }]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Individual days a vendor has blocked off (vendor-blackout screen).
model VendorBlackout {
  id           String   @id @default(cuid())
  vendorUserId String
  vendor       User     @relation("VendorBlackouts", fields: [vendorUserId], references: [id], onDelete: Cascade)
  date         DateTime @db.Date
  reason       String?
  createdAt    DateTime @default(now())

  @@unique([vendorUserId, date])
  @@index([vendorUserId])
}

// A discrete service in a vendor's menu (BookService + vendor-menu screens).
// Distinct from VendorProfile.serviceCategory (the vendor's headline trade).
model VendorService {
  id           String                 @id @default(cuid())
  vendorUserId String
  vendor       User                   @relation("VendorServices", fields: [vendorUserId], references: [id], onDelete: Cascade)
  name         String
  description  String
  priceNaira   Int
  priceMode    VendorServicePriceMode @default(FIXED)
  duration     String? // e.g. "2-3 hrs", "Full day"
  active       Boolean                @default(true) // archived = !active
  displayOrder Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([vendorUserId])
}

model VendorProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Onboarding fields
  serviceCategory String // Plumber, Electrician, Builder, etc.
  yearsExperience String // free text in onboarding ("5 years")
  serviceArea     String // e.g. "Lekki, Ajah, Victoria Island"

  // Directory fields (Vendor interface in src/data/vendors.ts)
  priceLabel String? // "From ₦15,000"
  priceNum   Int? // 15000
  website    String? // Vendor's website/portfolio URL

  // Media
  bannerImage      String? // Hero image for directory card
  portfolioImages  String[] // Past work samples
  availableForHire Boolean  @default(true)

  // Stats
  rating    Float    @default(0)
  jobsCount Int      @default(0)
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VendorBankAccount {
  id           String @id @default(cuid())
  vendorUserId String @unique
  vendor       User   @relation("VendorBankAccount", fields: [vendorUserId], references: [id], onDelete: Cascade)

  accountName           String
  accountNumber         String
  bankCode              String
  bankName              String
  // Optional: payouts are processed manually by an admin (Paystack transfers
  // aren't enabled on our account), so a recipient code is nice-to-have for a
  // future automated flow, not a requirement to save a bank account.
  paystackRecipientCode String?

  // Paystack subaccount for the marketplace split-payment flow. When present,
  // a marketplace order routes this vendor's net share straight to their bank
  // at checkout (no escrow, no manual payout). Created best-effort when the
  // bank account is saved; absent until Paystack accepts it.
  paystackSubaccountCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Vendor withdrawals — manual payouts. Paystack transfers aren't enabled on
// our account, so a withdrawal creates a PENDING request that an admin settles
// by making the bank transfer themselves, then marking it paid (or rejecting,
// which returns the earnings to the vendor's withdrawable balance).
// ─────────────────────────────────────────────────────────────────────────────

enum WithdrawalStatus {
  PENDING // vendor requested — waiting on an admin to transfer manually
  PAID // admin transferred the money and confirmed
  REJECTED // admin declined — earnings returned to AVAILABLE
}

model WithdrawalRequest {
  id           String @id @default(cuid())
  vendorUserId String
  vendor       User   @relation("VendorWithdrawals", fields: [vendorUserId], references: [id], onDelete: Cascade)

  amountNaira Int
  status      WithdrawalStatus @default(PENDING)

  // Snapshot of the payout account at request time — this is the account the
  // admin transfers to, even if the vendor edits their bank details later.
  bankName      String
  accountNumber String
  accountName   String

  adminNote   String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?

  earnings VendorEarning[]

  @@index([vendorUserId])
  @@index([status])
}

model SubscriptionPayment {
  id             String       @id @default(cuid())
  agentProfileId String
  agentProfile   AgentProfile @relation(fields: [agentProfileId], references: [id], onDelete: Cascade)

  tier               SubscriptionTier
  amountKobo         Int
  paystackRef        String           @unique // Paystack transaction reference
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  status             String // "success" | "failed" | "pending"

  createdAt DateTime @default(now())

  @@index([agentProfileId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Notifications (5 toggles in Settings.tsx)
  notifEmail       Boolean @default(true)
  notifSms         Boolean @default(true)
  notifMessages    Boolean @default(true)
  notifPriceAlerts Boolean @default(true)
  notifMarketing   Boolean @default(false)

  // Privacy
  profileVisible Boolean @default(true)
  shareActivity  Boolean @default(false)

  // Preferences
  language String @default("English")
  currency String @default("NGN")

  // Security
  twoFactorEnabled Boolean @default(false)
  twoFactorSecret  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth tokens — sessions + rotating refresh + verification + reset
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Opaque session token (hashed at rest)
  tokenHash String @unique

  // Device metadata for the Settings "active devices" UI
  userAgent   String?
  ipAddress   String?
  deviceLabel String? // e.g. "Chrome on Windows"

  // Lifecycle
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  // Rotation chain — when this token is used, a new one is issued and this one
  // is marked replaced. Reuse of a replaced token = stolen token = revoke chain.
  replacedById String?

  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Frontend ForgotPassword.tsx uses a 6-digit code flow → store hash of code
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Domain — listings, products, bookmarks, conversations, orders, vendor work
// ─────────────────────────────────────────────────────────────────────────────

model Listing {
  id      String @id @default(cuid())
  agentId String
  agent   User   @relation("AgentListings", fields: [agentId], references: [id], onDelete: Cascade)

  // From Listing interface in src/data/listings.ts
  title          String
  slug           String        @unique
  type           ListingType
  propertyType   String // "Flat / Apartment", "Detached House", etc.
  priceNaira     BigInt // store as integer naira (BigInt — Banana Island can hit ₦5-10B which overflows int4)
  priceLabel     String // "₦65,000,000" — keep frontend's formatted string for backwards compat
  period         String? // "/year" for rentals, "/night" for shortlets
  address        String
  location       String // "Lekki, Lagos"
  beds           Int
  baths          Int
  sqft           String // free-text, matches frontend ("2,400")
  yearBuilt      String?
  description    String
  features       String[] // ["24hr Power", "Swimming Pool", ...]
  coverImage     String
  images         String[]
  rating         Float         @default(0)
  verified       Boolean       @default(false)
  status         ListingStatus @default(PENDING_REVIEW)
  viewsCount     Int           @default(0)
  featured       Boolean       @default(false) // Pro "Featured placement" — top of search
  openToOffers   Boolean       @default(false) // "Accept offers" — buyers can submit offers
  // Video tour fields (matches data/videos.ts VideoListing interface)
  virtualTourUrl String? // YouTube embed URL
  videoUrl       String? // Property video URL (upload or external)
  videoUrls      String[] // Multiple video URLs
  videoThumbnail String? // Thumbnail image for video card
  videoDuration  String? // e.g. "2:34"
  videoViewCount Int           @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ─── Team portal attribution ───────────────────────────────────────────
  // agentId is who OWNS the listing. Neither of these existed before, so
  // "Ola listed 14 properties this month" could not be answered from the
  // database at all — it was a claim, not a fact.

  /// The staff member who brought this listing in.
  sourcedByStaffId String?
  sourcedByStaff   StaffProfile? @relation("ListingSourcedBy", fields: [sourcedByStaffId], references: [id], onDelete: SetNull)

  /// AGENT_OWN unless staff posted it, in which case it is house stock that
  /// partners may work. Set by the API from who is posting, never by the
  /// client — an agent must not be able to label their own listing as ours.
  ownership ListingOwnership @default(AGENT_OWN)

  /// The mandate this property arrived through, if any.
  fromDealId String?
  fromDeal   Deal?   @relation("ListingFromDeal", fields: [fromDealId], references: [id], onDelete: SetNull)

  shoots             Shoot[]             @relation("ListingShoots")
  partnerCommissions PartnerCommission[] @relation("ListingPartnerCommissions")

  documents          ListingDocument[]
  bookmarkedBy       Bookmark[]            @relation("ListingBookmarks")
  leads              Lead[]
  viewings           Viewing[]
  shortletBookings   ShortletBooking[]
  rentalApplications RentalApplication[]
  logbookEntries     LogbookEntry[]
  priceHistory       ListingPriceHistory[]
  offers             Offer[]
  purchases          PropertyPurchase[]
  feedShares         FeedPost[]            @relation("FeedListingShares")

  /// Staff portal fields. A developer mandate arrives as a block of units,
  /// not one property, and the count is what the pipeline is measured on.
  units       Int       @default(1)
  unitsSold   Int       @default(0)
  /// Which chapter sourced it. Null on agent listings, which predate chapters.
  chapter     Chapter?
  /// When it went ACTIVE. status alone cannot answer "published this month".
  publishedAt DateTime?

  @@index([agentId])
  @@index([type])
  @@index([location])
  @@index([status])
  @@index([sourcedByStaffId])
  @@index([fromDealId])
  @@index([ownership])
  @@index([chapter])
}

model ListingDocument {
  id        String       @id @default(cuid())
  listingId String
  listing   Listing      @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String // "Certificate of Occupancy"
  type      DocumentType
  url       String? // Public URL of the uploaded file in R2
  verified  Boolean      @default(false)
  date      String // matches frontend's free-text "Sep 2022"
  createdAt DateTime     @default(now())

  @@index([listingId])
}

model Product {
  id           String   @id @default(cuid())
  slug         String   @unique
  name         String
  supplier     String
  category     String // "Cement & Concrete", "Roofing", ...
  description  String
  priceNaira   Int
  priceLabel   String
  unit         String // "bag", "sqm", "litre"
  minOrder     String // "10 bags"
  location     String
  phone        String
  coverImage   String
  images       String[]
  specs        Json // [{label, value}, ...] — flexible per product
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  verified     Boolean  @default(false)
  inStock      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookmarkedBy Bookmark[]  @relation("ProductBookmarks")
  orderItems   OrderItem[]

  @@index([category])
}

model Bookmark {
  id     String       @id @default(cuid())
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  type   BookmarkType

  // Optional typed FKs — only one is set per row, depending on `type`
  listingId    String?
  listing      Listing? @relation("ListingBookmarks", fields: [listingId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation("ProductBookmarks", fields: [productId], references: [id], onDelete: Cascade)
  // For "service" bookmarks, points at a vendor User row
  vendorUserId String?
  vendor       User?    @relation("VendorBookmarks", fields: [vendorUserId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, type, listingId, productId, vendorUserId])
  @@index([userId])
}

enum ConversationKind {
  /// Buyer↔agent, buyer↔vendor — everything the marketplace already had.
  CUSTOMER
  /// Staff one-to-one.
  STAFF_DIRECT
  /// The all-staff group.
  STAFF_GROUP
  /// Staff discussion pinned to a record (listing, deal, lead, shoot).
  STAFF_THREAD
}

model Conversation {
  id String @id @default(cuid())

  // Optional context — what the conversation is about
  listingId String?
  productId String?

  // ─── Team portal ───────────────────────────────────────────────────────
  // MessagesService.listConversations returns every conversation a user
  // participates in. Without this flag a staff member who is also an agent
  // would see internal threads sitting in their customer inbox, so the
  // listing query filters on it and every staff-side query requires it.
  isInternal Boolean          @default(false)
  kind       ConversationKind @default(CUSTOMER)
  /// Set for STAFF_GROUP and STAFF_THREAD; a direct chat is named by whoever
  /// is in it.
  title      String?

  /// Record a STAFF_THREAD is pinned to. listingId above doubles as the
  /// property link, so only the three the marketplace lacked are added here.
  dealId  String?
  deal    Deal?   @relation("DealThreads", fields: [dealId], references: [id], onDelete: Cascade)
  leadId  String?
  lead    Lead?   @relation("LeadThreads", fields: [leadId], references: [id], onDelete: Cascade)
  shootId String?
  shoot   Shoot?  @relation("ShootThreads", fields: [shootId], references: [id], onDelete: Cascade)

  /// Threads get resolved; customer conversations do not.
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@index([isInternal, kind])
  @@index([dealId])
  @@index([leadId])
  @@index([shootId])
}

model ConversationParticipant {
  id             String                      @id @default(cuid())
  conversationId String
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ConversationParticipantRole
  unreadCount    Int                         @default(0)
  // When this participant last opened/read the conversation. Drives read
  // receipts: a message counts as "read" once every other participant's
  // lastReadAt is past its createdAt.
  lastReadAt     DateTime?

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)
  text           String
  attachmentUrls String[]
  createdAt      DateTime     @default(now())

  @@index([conversationId])
}

model Order {
  id String @id @default(cuid())

  // Human-readable order number shown in OrderConfirmation.tsx ("MAT-...")
  orderNumber String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Delivery details (Checkout.tsx)
  recipientName String
  phone         String
  address       String
  city          String
  notes         String?

  // Money — naira-int to match frontend math
  subtotal    Int
  deliveryFee Int
  serviceFee  Int
  total       Int
  payMethod   OrderPaymentMethod

  placedAt DateTime @default(now())

  items OrderItem[]

  @@index([userId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])

  // Snapshot the product fields at order time so they don't change if Product is edited
  name       String
  supplier   String
  image      String
  priceLabel String
  unit       String
  unitPrice  Int // naira at time of order
  quantity   Int

  @@index([orderId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Vendor Marketplace — branded storefronts, products, and multi-vendor orders.
//
// Distinct from the legacy `Product`/`Order` pair above (building-materials
// marketplace, keyed to a free-text `supplier`). Here a store belongs to a real
// VENDOR user, so sales attribute to an account we can pay. PropertyLoop takes a
// commission per store; the rest is owed to the vendor and settled through the
// same manual-withdrawal model the vendor-jobs flow already uses.
// ─────────────────────────────────────────────────────────────────────────────

enum MarketplaceOrderStatus {
  PENDING // created, redirected to Paystack, not yet confirmed
  PAID // charge.success verified — vendor amounts owed are recorded
  FULFILLED // every item dispatched/delivered
  CANCELLED // abandoned at checkout or cancelled before payment
  DISPUTED // buyer opened a dispute; awaiting admin resolution
  REFUNDED // money returned to the buyer (full or partial)
}

/// How a single order line's money reached the vendor.
enum MarketplacePayoutStatus {
  PAID_OUT // split straight to the vendor's Paystack subaccount at checkout
  OWED // vendor had no subaccount — recorded as an owed earning, settled by admin
  REFUNDED // the line was refunded to the buyer; nothing is owed to the vendor
}

enum MarketplaceDisputeStatus {
  OPEN // raised by the buyer, awaiting an admin
  RESOLVED_REFUND // admin refunded (full or partial)
  RESOLVED_REJECTED // admin rejected — no refund
  CANCELLED // buyer withdrew the dispute
}

model MarketplaceStore {
  id          String @id @default(cuid())
  slug        String @unique
  ownerUserId String
  owner       User   @relation("OwnedStores", fields: [ownerUserId], references: [id], onDelete: Cascade)

  name        String
  tagline     String
  bio         String
  logo        String
  banner      String
  accent      String @default("#2b4e3b") // hex, drives the storefront's branding
  category    String
  location    String
  phone       String
  email       String
  established String @default("")

  // Platform commission taken from this store's sales, as a percent. Kept for
  // back-compat; the live rate now resolves per product category (see
  // marketplace.constants.ts). commissionPctOverride, when set, wins over the
  // category rate — a negotiated rate for a high-volume vendor.
  commissionPct         Int  @default(7)
  commissionPctOverride Int?

  verified Boolean @default(false)
  active   Boolean @default(true) // false hides the store without deleting it

  // Denormalised display stats, recomputed as orders/reviews land.
  rating          Float @default(0)
  reviewsCount    Int   @default(0)
  ordersFulfilled Int   @default(0)

  responseTime  String   @default("within a day")
  deliveryAreas String[]
  // Flexible per-store JSON: policies [{icon,label,detail}], promo {title,subtitle,code},
  // collections [{id,title,subtitle,image}]. Shaped to match the storefront UI.
  policies      Json     @default("[]")
  promo         Json?
  collections   Json     @default("[]")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products   MarketplaceProduct[]
  orderItems MarketplaceOrderItem[]

  @@index([ownerUserId])
  @@index([category])
  @@index([active])
}

model MarketplaceProduct {
  id      String           @id @default(cuid())
  storeId String
  store   MarketplaceStore @relation(fields: [storeId], references: [id], onDelete: Cascade)

  slug           String   @unique
  name           String
  description    String
  priceNaira     Int
  compareAtNaira Int? // strike-through "was" price; null when not on sale
  category       String
  coverImage     String
  gallery        String[]
  specs          Json     @default("[]") // [{label,value}, ...]
  options        Json     @default("[]") // [{label, values:[...]}, ...]
  tag            String? // "new" | "bestseller" | "sale"
  bulkEligible   Boolean  @default(false)

  rating       Float   @default(0)
  reviewsCount Int     @default(0)
  inStock      Boolean @default(true)
  stockQty     Int? // null = untracked / made-to-order; 0 = sold out
  active       Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems MarketplaceOrderItem[]

  @@index([storeId])
  @@index([category])
  @@index([active])
}

model MarketplaceOrder {
  id          String @id @default(cuid())
  orderNumber String @unique // human-facing, "PLM-..."

  // Null for guest checkout — the order still stands on the snapshotted contact.
  buyerUserId String?
  buyer       User?   @relation("MarketplaceOrders", fields: [buyerUserId], references: [id], onDelete: SetNull)

  buyerName  String
  buyerEmail String
  buyerPhone String

  address String
  city    String
  state   String
  notes   String?

  // Naira ints, matching the frontend's money math.
  subtotal    Int
  deliveryFee Int
  platformFee Int // buyer-facing service fee (distinct from vendor commission)
  total       Int

  status      MarketplaceOrderStatus @default(PENDING)
  paystackRef String                 @unique
  paidAt      DateTime?

  // Refund bookkeeping. refundedNaira accumulates across partial refunds so a
  // second refund can never exceed what is left.
  refundedNaira Int       @default(0)
  refundedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    MarketplaceOrderItem[]
  disputes MarketplaceDispute[]

  @@index([buyerUserId])
  @@index([status])
}

model MarketplaceOrderItem {
  id      String           @id @default(cuid())
  orderId String
  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  storeId   String
  store     MarketplaceStore   @relation(fields: [storeId], references: [id], onDelete: Restrict)

  // Snapshot of product + store at order time, so later edits don't rewrite history.
  name         String
  image        String
  storeName    String
  category     String  @default("") // product category at order time — drives the commission rate
  vendorUserId String // store owner at order time — who the payout is owed to
  unitPrice    Int
  quantity     Int
  options      Json? // selected variant, e.g. { "Colour": "Olive" }

  // Commission split, fixed at order creation (deterministic from price × qty × pct).
  commissionPct   Int
  commissionNaira Int
  vendorNetNaira  Int

  // How this line's net reached the vendor. Set when the order is paid: PAID_OUT
  // when it was split to their subaccount, OWED when it fell back to the manual
  // queue. Flipped to REFUNDED if the line is later refunded.
  payoutStatus         MarketplacePayoutStatus @default(OWED)
  paystackSubaccount   String? // the subaccount the split targeted, if any

  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([storeId])
  @@index([vendorUserId])
}

/// A buyer-raised dispute on a paid marketplace order. An admin with
/// MANAGE_MARKETPLACE resolves it, optionally issuing a full or partial refund.
model MarketplaceDispute {
  id      String           @id @default(cuid())
  orderId String
  order   MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // The buyer who raised it. Null for a guest order (identified by the order).
  raisedByUserId String?
  raisedBy       User?   @relation("MarketplaceDisputesRaised", fields: [raisedByUserId], references: [id], onDelete: SetNull)

  reason  String // short category, e.g. "Item not delivered"
  details String // the buyer's description

  status MarketplaceDisputeStatus @default(OPEN)

  // Set on resolution.
  resolvedByStaffId String?
  resolutionNote    String?
  refundNaira       Int       @default(0)
  resolvedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
}

// Vendor work (matches src/data/vendor-dashboard.ts interfaces)

model VendorJob {
  id           String @id @default(cuid())
  vendorUserId String
  vendor       User   @relation("VendorJobs", fields: [vendorUserId], references: [id], onDelete: Restrict)

  // Buyer who booked the job (null for guest bookings)
  buyerUserId String?
  buyer       User?   @relation("VendorBuyerJobs", fields: [buyerUserId], references: [id], onDelete: SetNull)

  title        String
  clientName   String
  clientAvatar String?
  clientPhone  String
  clientEmail  String?
  address      String
  category     String
  status       JobStatus @default(PENDING)
  amount       Int // naira — legacy, same as vendorFee
  description  String
  scheduledFor DateTime?

  // Booking details (from BookService.tsx)
  negotiationNotes String? // Free-text negotiation notes between buyer & vendor
  preferredTime    String? // e.g. "Morning", "Afternoon", "Evening"
  attachments      String[] // Image/video URLs uploaded by buyer at booking time

  // Escrow (placeholder until Paystack wiring)
  escrowId      String?      @unique
  escrowStatus  EscrowStatus @default(NONE)
  escrowAmount  Int          @default(0) // what the buyer pays = the vendor's listed price (no markup)
  vendorFee     Int          @default(0) // vendor's net take = 90% of the price
  platformFee   Int          @default(0) // 10% PropertyLoop commission, deducted from the vendor's cut
  paymentMethod String?

  // The vendor fee is paid in two halves: depositAmount lands in their balance
  // when they start work, finalAmount when the buyer confirms. Invariant:
  // depositAmount + finalAmount = vendorFee. Jobs predating the split payout
  // have depositAmount = 0 and finalAmount = vendorFee.
  depositAmount     Int       @default(0)
  finalAmount       Int       @default(0)
  depositReleasedAt DateTime?

  // Completion & dispute
  completionProofImages String[]
  completionNotes       String?
  completedAt           DateTime?
  confirmedAt           DateTime?
  disputeReason         String?
  disputedAt            DateTime?
  refundedAt            DateTime?

  // Paystack integration
  escrowPaidAt DateTime? // when webhook confirms charge.success
  transferCode String? // Paystack transfer code after release

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  earnings        VendorEarning[]
  reviews         VendorReview[]
  logbookEntry    LogbookEntry?
  disputeMessages JobDisputeMessage[]

  @@index([vendorUserId])
  @@index([buyerUserId])
  @@index([status])
  @@index([escrowStatus])
  @@index([transferCode])
}

// Threaded conversation on a disputed VendorJob. The customer raises the
// dispute (first CUSTOMER message + a SYSTEM mediation note), the vendor
// responds with evidence, and admins can weigh in — all scoped to one job.
enum DisputeAuthorRole {
  CUSTOMER
  VENDOR
  SYSTEM
  ADMIN
}

model JobDisputeMessage {
  id           String            @id @default(cuid())
  jobId        String
  job          VendorJob         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // Null for SYSTEM messages.
  senderUserId String?
  sender       User?             @relation("DisputeMessages", fields: [senderUserId], references: [id], onDelete: SetNull)
  role         DisputeAuthorRole
  body         String
  attachments  String[]
  createdAt    DateTime          @default(now())

  @@index([jobId])
}

model VendorEarning {
  id           String    @id @default(cuid())
  vendorUserId String
  vendor       User      @relation("VendorEarnings", fields: [vendorUserId], references: [id], onDelete: Cascade)
  jobId        String
  job          VendorJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  jobTitle   String
  clientName String
  amount     Int
  // Which half of the fee this row represents. See EarningKind.
  kind       EarningKind   @default(FINAL)
  status     EarningStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime      @default(now())

  // Set while the earning is inside a manual withdrawal (PROCESSING). Cleared
  // if the request is rejected (earning returns to AVAILABLE).
  withdrawalRequestId String?
  withdrawalRequest   WithdrawalRequest? @relation(fields: [withdrawalRequestId], references: [id], onDelete: SetNull)

  // One row per half, which keeps the release/refund upserts idempotent.
  @@unique([jobId, kind])
  @@index([vendorUserId])
  @@index([jobId])
  @@index([withdrawalRequestId])
}

model VendorReview {
  id           String     @id @default(cuid())
  vendorUserId String
  vendor       User       @relation("VendorReviews", fields: [vendorUserId], references: [id], onDelete: Cascade)
  jobId        String?
  job          VendorJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  clientName   String
  clientAvatar String?
  rating       Int // 1–5
  comment      String
  jobTitle     String
  reply        String? // public reply from the vendor
  repliedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([vendorUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Agent leads, viewings, and reviews
// ─────────────────────────────────────────────────────────────────────────────

model Lead {
  id          String  @id @default(cuid())
  // Agent who owns the lead (the listing's agent)
  agentId     String
  agent       User    @relation("AgentLeads", fields: [agentId], references: [id], onDelete: Cascade)
  // Listing the lead is interested in
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  // Optional buyer user (null for guest enquiries)
  buyerUserId String?
  buyer       User?   @relation("BuyerLeads", fields: [buyerUserId], references: [id], onDelete: SetNull)

  // Snapshotted contact info (in case the buyer is a guest)
  name    String
  email   String?
  phone   String
  message String?

  // Team portal: the partner who introduced this buyer. What makes a
  // commission attributable — without it, "I brought that buyer" is a claim
  // somebody makes after the sale rather than a record made before it.
  broughtByPartnerId String?
  broughtByPartner   AgentPartner? @relation("PartnerLeads", fields: [broughtByPartnerId], references: [id], onDelete: SetNull)

  status      LeadStatus @default(NEW)
  source      LeadSource @default(LISTING_PAGE)
  // Free-text agent notes
  notes       String?
  contactedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Staff portal fields. The agent-facing columns above describe who OWNS
  /// the listing; these describe who inside PropertyLoop is working the
  /// enquiry, which is a different person and a different question.
  ownerStaffId     String?
  ownerStaff       StaffProfile? @relation("StaffOwnedLeads", fields: [ownerStaffId], references: [id], onDelete: SetNull)
  /// Budget confirmed, timeline stated, property of interest named. One
  /// explicit flag so Marketing and the GM read the same number.
  qualified        Boolean       @default(false)
  budgetNaira      BigInt?
  /// First reply to the enquiry. Operations is measured on 30 minutes from
  /// createdAt to here, so it is a timestamp rather than a stored duration —
  /// a duration would need recomputing every time either end moved.
  firstRespondedAt DateTime?

  // Team portal: staff discussion pinned to this lead.
  conversations     Conversation[]      @relation("LeadThreads")
  partnerCommission PartnerCommission[] @relation("LeadPartnerCommission")

  @@index([agentId])
  @@index([listingId])
  @@index([status])
  @@index([broughtByPartnerId])
  @@index([ownerStaffId])
  @@index([qualified])
}

model Viewing {
  id          String  @id @default(cuid())
  agentId     String
  agent       User    @relation("AgentViewings", fields: [agentId], references: [id], onDelete: Cascade)
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerViewings", fields: [buyerUserId], references: [id], onDelete: SetNull)

  // Snapshotted contact info
  clientName  String
  clientPhone String
  clientEmail String?

  scheduledFor DateTime
  status       ViewingStatus @default(PENDING)
  notes        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([listingId])
  @@index([scheduledFor])
  @@index([status])
}

model AgentReview {
  id             String  @id @default(cuid())
  // Agent being reviewed
  agentUserId    String
  agent          User    @relation("AgentReviewsReceived", fields: [agentUserId], references: [id], onDelete: Cascade)
  // Reviewer (optional — guest reviews allowed)
  reviewerUserId String?
  reviewer       User?   @relation("AgentReviewsWritten", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  // Snapshotted reviewer name
  reviewerName   String

  rating  Int // 1-5
  comment String

  createdAt DateTime @default(now())

  @@index([agentUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Blog
// ─────────────────────────────────────────────────────────────────────────────

enum BlogCategory {
  MARKET_INSIGHTS
  GUIDES
  PRODUCT_UPDATES
  AGENT_TIPS
}

model BlogPost {
  id        String       @id @default(cuid())
  slug      String       @unique
  title     String
  excerpt   String
  content   String[] // Array of paragraphs / markdown blocks
  category  BlogCategory
  image     String // Cover image URL
  author    String
  avatar    String? // Author avatar URL
  readTime  String // e.g. "5 min read"
  published Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([category])
  @@index([published])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property Logbook — permanent maintenance history per property
// ─────────────────────────────────────────────────────────────────────────────

model LogbookEntry {
  id          String     @id @default(cuid())
  // Property reference (nullable for vendor jobs not yet linked to a property)
  listingId   String?
  listing     Listing?   @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Vendor job that generated this entry (auto-logged on escrow release)
  jobId       String?    @unique
  job         VendorJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)
  // Owner at time of entry
  ownerUserId String
  owner       User       @relation("LogbookOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Entry details (snapshot from completed VendorJob)
  category    String // Plumbing, Electrical, etc.
  title       String // Job title / summary
  description String?
  vendorName  String
  vendorId    String?
  cost        Int // naira
  completedAt DateTime
  verified    Boolean  @default(false) // true when confirmed via escrow

  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([ownerUserId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Listing price history — recorded on each price update by agent
// ─────────────────────────────────────────────────────────────────────────────

model ListingPriceHistory {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  oldPrice  BigInt
  newPrice  BigInt
  changedAt DateTime @default(now())

  @@index([listingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Partners — displayed on homepage partner logo section
// ─────────────────────────────────────────────────────────────────────────────

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  website   String?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Shortlet bookings & rental applications (buyer-side)
// ─────────────────────────────────────────────────────────────────────────────

model ShortletBooking {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerShortlets", fields: [buyerUserId], references: [id], onDelete: SetNull)

  guestName  String
  guestPhone String
  guestEmail String?
  guests     Int

  checkIn  DateTime
  checkOut DateTime
  nights   Int

  subtotal   Int // pricePerNight * nights
  serviceFee Int // 10%
  total      Int

  paymentMethod String?
  escrowId      String?               @unique
  escrowStatus  EscrowStatus          @default(NONE)
  status        ShortletBookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([buyerUserId])
  @@index([status])
}

model RentalApplication {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerUserId String?
  buyer       User?   @relation("BuyerRentals", fields: [buyerUserId], references: [id], onDelete: SetNull)

  applicantName  String
  applicantPhone String
  applicantEmail String?

  deposit    Int // annual rent
  agencyFee  Int // 10%
  legalFee   Int
  serviceFee Int // 5%
  total      Int

  leaseDuration String // "12 months"
  startDate     DateTime

  paymentMethod String?
  escrowId      String?                 @unique
  escrowStatus  EscrowStatus            @default(NONE)
  status        RentalApplicationStatus @default(PENDING)

  signedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([listingId])
  @@index([buyerUserId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Reports (user reports of agents, vendors, listings)
// ─────────────────────────────────────────────────────────────────────────────

model Report {
  id         String  @id @default(cuid())
  reporterId String?
  reporter   User?   @relation("UserReports", fields: [reporterId], references: [id], onDelete: SetNull)

  targetType ReportTargetType
  targetId   String
  reason     String

  status    ReportStatus @default(PENDING)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([targetType, targetId])
  @@index([status])
  @@index([reporterId])
}

// Blocking another user is instant and client-enforced: it hides that user's
// content from the blocker (conversation, listings, profile) and stops them
// from messaging the blocker again. Also creates a Report (targetType USER)
// so the team reviews the blocked account — App Store guideline 1.2 requires
// blocking to notify the developer of the inappropriate content, not just
// silently hide it from the blocker.
model BlockedUser {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)
  reason    String?
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Property purchase offers + negotiation + purchase progress
//
// Agents NEVER collect money on the platform — these flows are negotiation +
// status tracking only. Any sale funds are settled off-platform between buyer
// and seller (the app copy says "Non-binding · you and the seller settle
// directly"). No Paystack charge/transfer is involved here.
// ─────────────────────────────────────────────────────────────────────────────

enum OfferStatus {
  PENDING // submitted, awaiting the agent's response
  COUNTERED // a counter is on the table (made by agent or buyer)
  ACCEPTED // both sides agreed → a PropertyPurchase is created
  DECLINED // rejected by the agent
  WITHDRAWN // pulled by the buyer
  EXPIRED // deadline passed with no agreement
}

enum OfferFinancing {
  CASH
  OWN_FINANCING
}

enum OfferActor {
  BUYER
  AGENT
}

enum OfferEventType {
  OFFER // initial offer
  COUNTER // a counter-offer
  ACCEPT
  DECLINE
  WITHDRAW
  EXPIRE
}

enum PurchaseStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PurchaseStepState {
  DONE
  ACTIVE
  TODO
}

model Offer {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("BuyerOffers", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId   String // denormalised from the listing for fast agent-side queries
  agent     User    @relation("AgentOffers", fields: [agentId], references: [id], onDelete: Cascade)

  // Buyer's original terms
  amountNaira         BigInt // BigInt to match Listing.priceNaira (prices can exceed int4)
  financing           OfferFinancing @default(CASH)
  note                String?
  closeDate           DateTime?
  subjectToInspection Boolean        @default(true)

  // Live negotiation state
  status             OfferStatus @default(PENDING)
  currentAmountNaira BigInt // latest figure on the table (initial offer or most recent counter)
  lastActor          OfferActor  @default(BUYER) // who made the last move
  expiresAt          DateTime? // optional buyer-set deadline for a response

  events   OfferEvent[]
  purchase PropertyPurchase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([agentId])
  @@index([listingId])
  @@index([status])
}

model OfferEvent {
  id          String         @id @default(cuid())
  offerId     String
  offer       Offer          @relation(fields: [offerId], references: [id], onDelete: Cascade)
  type        OfferEventType
  actor       OfferActor
  amountNaira BigInt? // present for OFFER and COUNTER events
  note        String?
  createdAt   DateTime       @default(now())

  @@index([offerId])
}

model PropertyPurchase {
  id        String  @id @default(cuid())
  offerId   String  @unique
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  buyerId   String
  buyer     User    @relation("BuyerPurchases", fields: [buyerId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User    @relation("AgentPurchases", fields: [agentId], references: [id], onDelete: Cascade)

  agreedAmountNaira BigInt
  status            PurchaseStatus @default(IN_PROGRESS)

  steps PurchaseStep[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([buyerId])
  @@index([agentId])
}

model PurchaseStep {
  id          String            @id @default(cuid())
  purchaseId  String
  purchase    PropertyPurchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  order       Int
  key         String // stable identifier, e.g. "OFFER_ACCEPTED", "TITLE_SEARCH"
  title       String
  detail      String
  state       PurchaseStepState @default(TODO)
  eta         String?
  completedAt DateTime?

  @@index([purchaseId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications — in-app feed + Expo push
//
// `type` is a free-text key (see notification-types.ts) rather than an enum so
// new notification kinds can ship without a schema migration. `data` carries a
// small JSON payload the mobile app uses to deep-link (e.g. { offerId }).
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // e.g. "OFFER_RECEIVED", "OFFER_ACCEPTED", "JOB_REQUEST"
  title String
  body  String
  data  Json? // deep-link payload, e.g. { "offerId": "..." }

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model PushToken {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token      String   @unique // Expo push token (ExponentPushToken[...])
  platform   String? // "ios" | "android"
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

/// A phone or browser subscribed to team portal notifications (Web Push).
model WebPushSubscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  endpoint   String   @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

/// The server's VAPID key pair, when it is not supplied through the environment.
model WebPushConfig {
  id         String   @id
  publicKey  String
  privateKey String
  createdAt  DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Identity / KYC verification (interim: doc upload + admin approval).
// Smile Identity integration can replace the manual review later.
// ─────────────────────────────────────────────────────────────────────────────

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

model KycSubmission {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("KycSubmission", fields: [userId], references: [id], onDelete: Cascade)

  fullName       String?
  documentType   String // "NIN" | "Passport" | "Drivers License" | "Voters Card" | "CAC"
  documentNumber String?
  documentUrls   String[] // uploaded ID images / PDFs
  selfieUrl      String?

  status          KycStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Social feed — community posts shared between agents, vendors, buyers,
// sellers and developers. Post types mirror the composer chips on the web
// feed (update / market insight / completed project / property tip /
// industry news / poll / listing share).
// ─────────────────────────────────────────────────────────────────────────────

enum FeedPostType {
  UPDATE
  INSIGHT
  PROJECT
  TIP
  NEWS
  POLL
  LISTING
}

model FeedPost {
  id       String       @id @default(cuid())
  authorId String
  author   User         @relation("FeedPosts", fields: [authorId], references: [id], onDelete: Cascade)
  type     FeedPostType @default(UPDATE)
  body     String

  // Photo posts (R2 URLs, up to 4 rendered as a collage)
  images String[] @default([])

  // Video posts (R2 URLs). Capped at one and mutually exclusive with images:
  // a post is either a photo collage or a single clip, which keeps the card
  // layout from having to reconcile both. No poster frame is generated, so
  // the tile shows a play control over black until it's tapped.
  videos String[] @default([])

  // Listing share — embeds one of the author's listings as a card
  listingId String?
  listing   Listing? @relation("FeedListingShares", fields: [listingId], references: [id], onDelete: SetNull)

  // Market-insight card (all optional; bars are relative heights 0-100)
  insightMetric String?
  insightPeriod String?
  insightDelta  String?
  insightBars   Int[]   @default([])

  // Completed-project card
  projectName     String?
  projectLocation String?
  projectUnits    String?

  // Poll
  pollEndsAt  DateTime?
  pollOptions FeedPollOption[]

  likes    FeedLike[]
  saves    FeedSave[]
  comments FeedComment[]
  reports  FeedReport[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([createdAt])
  @@index([authorId])
  @@index([type])
}

model FeedReport {
  id         String       @id @default(cuid())
  postId     String
  post       FeedPost     @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?        @relation("FeedReports", fields: [reporterId], references: [id], onDelete: SetNull)
  reason     String?
  status     ReportStatus @default(PENDING)

  createdAt DateTime @default(now())

  @@unique([postId, reporterId])
  @@index([status])
}

model FeedPollOption {
  id     String         @id @default(cuid())
  postId String
  post   FeedPost       @relation(fields: [postId], references: [id], onDelete: Cascade)
  text   String
  order  Int            @default(0)
  votes  FeedPollVote[]

  @@index([postId])
}

model FeedPollVote {
  id       String         @id @default(cuid())
  optionId String
  option   FeedPollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  postId   String // denormalised so one-vote-per-post is enforceable
  userId   String
  user     User           @relation("FeedPollVotes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model FeedLike {
  id     String   @id @default(cuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation("FeedLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedSave {
  id     String   @id @default(cuid())
  postId String
  post   FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId String
  user   User     @relation("FeedSaves", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedComment {
  id       String        @id @default(cuid())
  postId   String
  post     FeedPost      @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId String
  author   User          @relation("FeedComments", fields: [authorId], references: [id], onDelete: Cascade)
  body     String
  parentId String?
  parent   FeedComment?  @relation("FeedCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  FeedComment[] @relation("FeedCommentReplies")

  createdAt DateTime @default(now())

  @@index([postId])
}

model UserFollow {
  id          String @id @default(cuid())
  followerId  String
  follower    User   @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  followingId String
  following   User   @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Brand advertising — external brands pay a flat fee to run a creative in a
// placement slot for a fixed window. Self-serve: a brand signs up as a normal
// user, creates the ad, pays via Paystack (web checkout — never in the iOS
// app), and the ad goes live after admin review.
// ─────────────────────────────────────────────────────────────────────────────

enum AdPlacement {
  SPLASH // full-screen interstitial on app open
  HOME_BANNER // banner at the top of Home
  HOME_FEED // sponsored card inside the listings grid
  SEARCH_INLINE // inline card in search results
}

enum AdStatus {
  DRAFT // created, not paid yet
  PENDING_REVIEW // paid, waiting on admin approval
  ACTIVE // approved — serves while inside its run window
  PAUSED // temporarily pulled by admin
  REJECTED // failed review (payment refunded off-platform)
  EXPIRED // run window ended
}

model BrandAd {
  id          String @id @default(cuid())
  ownerUserId String
  owner       User   @relation("BrandAds", fields: [ownerUserId], references: [id], onDelete: Cascade)

  // Who the advertiser is
  brandName    String
  contactEmail String
  contactPhone String?

  // The creative
  imageUrl String
  headline String
  body     String?
  ctaLabel String  @default("Learn more")
  ctaUrl   String

  // Where + when it runs
  placement AdPlacement
  status    AdStatus    @default(DRAFT)
  priority  Int         @default(0) // rotation weight when a slot has several ads
  startAt   DateTime
  endAt     DateTime
  weeks     Int         @default(1)

  // The money (flat fee, computed server-side from placement × weeks)
  amountNaira Int
  paymentRef  String?   @unique
  paidAt      DateTime?

  // Reporting back to the brand
  impressions Int @default(0)
  clicks      Int @default(0)

  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, status])
  @@index([ownerUserId])
  @@index([status])
}

// ═══════════════════════════════════════════════════════════════════════════
// TEAM PORTAL
// ═══════════════════════════════════════════════════════════════════════════
// Internal staff tooling for the September 2026 org structure. Everything
// below is about how PropertyLoop runs itself — it is never exposed to
// buyers, agents or vendors.
//
// Two rules shape these models:
//
// 1. Where the marketplace already owns a fact, the team portal points at it
//    rather than copying it. A property's publish state stays Listing.status;
//    there is no second "published" flag here that could disagree with the
//    website.
//
// 2. Where nothing owns a fact — developers, mandates, shoots, daily logs —
//    the model lives here, because there was previously nowhere to put it.

enum StaffRole {
  MD_CEO
  GM
  PROPERTY_LISTING
  MARKETING
  OPERATIONS
  /// Runs the operations queue and the people working it.
  OPERATIONS_MANAGER
  AMBASSADOR
  SECRETARY
}

enum Chapter {
  LAGOS
  OSUN
}

/// Granular staff capabilities.
///
/// These exist because Role (BUYER | AGENT | VENDOR | ADMIN) has no staff
/// concept, so the only way to give the team logins was to make everyone an
/// ADMIN — which would hand a Secretary and a Video Presenter the power to
/// approve withdrawals and read KYC identity documents. A StaffProfile
/// carries an explicit grant list instead, checked by StaffPermissionsGuard.
enum StaffPermission {
  VIEW_REVENUE
  VIEW_ALL_TARGETS
  MANAGE_TARGETS
  MANAGE_DEALS
  MANAGE_PROPERTIES
  PUBLISH_PROPERTY
  VERIFY_DOCUMENTS
  MANAGE_LEADS
  QUALIFY_LEAD
  MANAGE_CONTENT
  HANDLE_OPS
  REVIEW_KYC
  APPROVE_WITHDRAWAL
  RESOLVE_DISPUTE
  VIEW_ALL_LOGS
  MANAGE_STAFF
  /// Work the agent partner directory — verify, assign, chase.
  MANAGE_PARTNERS
  /// Sign off a partner commission for payment. Separate from recording the
  /// sale on purpose: the person who logs it should not release it.
  APPROVE_COMMISSION
  /// Run the product marketplace — verify stores, set commission, oversee
  /// orders, and resolve refunds and disputes (money movement).
  MANAGE_MARKETPLACE
}

/// A member of staff.
///
/// Sits alongside User rather than replacing it: a staff member signs in with
/// the same credentials as anyone else, and this record is what makes them
/// staff. Never hard-deleted — the id is stamped on every property, deal,
/// lead, log and message the person touched, so removing it would orphan all
/// of that. `active = false` is what a vacant position looks like.
model StaffProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation("StaffProfile", fields: [userId], references: [id], onDelete: Cascade)

  /// "A"–"G", the letter used throughout the org document.
  letter           String
  staffRole        StaffRole
  chapter          Chapter           @default(LAGOS)
  /// Set for staff who also carry Osun chapter duties (Sodiq 1st).
  secondaryChapter Chapter?
  permissions      StaffPermission[]

  reportsToId String?
  reportsTo   StaffProfile?  @relation("StaffReports", fields: [reportsToId], references: [id], onDelete: SetNull)
  reports     StaffProfile[] @relation("StaffReports")

  active Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sourcedListings     Listing[]           @relation("ListingSourcedBy")
  deals               Deal[]              @relation("DealOwner")
  dailyLogs           DailyLog[]          @relation("StaffDailyLogs")
  presentedShoots     Shoot[]             @relation("ShootPresenter")
  preppedShoots       Shoot[]             @relation("ShootSecretary")
  contentPieces       ContentPiece[]      @relation("ContentOwner")
  targets             StaffTarget[]       @relation("StaffTargets")
  opsTasks            OpsTask[]           @relation("OpsTaskAssignee")
  partnersOwned       AgentPartner[]      @relation("PartnerOwner")
  commissionsApproved PartnerCommission[] @relation("CommissionApprover")

  ownedLeads Lead[] @relation("StaffOwnedLeads")

  @@index([staffRole])
  @@index([chapter])
  @@index([active])
}

// ─── Deals & mandates ──────────────────────────────────────────────────────
// Developers, advertisers, facility-management and building-finishing clients
// have no model anywhere else in the schema. This pipeline is the only record
// of them, which is exactly why it belongs in the database rather than a
// spreadsheet.

enum DealStage {
  IDENTIFIED
  CONTACTED
  PRESENTATION_SENT
  MEETING
  INVENTORY_RECEIVED
  MANDATE_SIGNED
  PUBLISHED
  LOST
}

enum DealKind {
  DEVELOPER
  ADVERTISER
  FACILITY_MANAGEMENT
  BUILDING_FINISHING
  REALTOR
}

enum MandateType {
  EXCLUSIVE
  PRIMARY
  OPEN
  NONE
}

model Deal {
  id           String      @id @default(cuid())
  company      String
  contactName  String
  contactPhone String?
  kind         DealKind
  stage        DealStage   @default(IDENTIFIED)
  mandate      MandateType @default(NONE)

  /// Expected commission or package value in whole naira. BigInt to match
  /// Listing.priceNaira — a Banana Island mandate overflows int4.
  valueNaira    BigInt @default(0)
  expectedUnits Int    @default(0)

  ownerId String
  owner   StaffProfile @relation("DealOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  chapter Chapter      @default(LAGOS)

  /// Set once the stage reaches MANDATE_SIGNED, so "mandates this month" is a
  /// date range query rather than a guess from the current stage.
  mandateSignedAt DateTime?

  nextAction   String?
  nextActionAt DateTime?
  notes        String    @default("")

  /// Bumped by every write. Drives the "stale — no activity in 7 days" flag.
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  /// Properties that arrived through this relationship. What makes a mandate
  /// measurable rather than asserted.
  listings      Listing[]      @relation("ListingFromDeal")
  conversations Conversation[] @relation("DealThreads")

  @@index([stage])
  @@index([ownerId])
  @@index([chapter])
  @@index([kind])
  @@index([lastActivityAt])
}

// ─── Daily logs ────────────────────────────────────────────────────────────

/// One entry per person per calendar day.
///
/// Read next to what the records already show for the same day (properties
/// submitted, deals advanced, leads contacted), which is computed on the fly
/// rather than stored — a written log on its own only measures how diligently
/// somebody reports.
model DailyLog {
  id      String       @id @default(cuid())
  staffId String
  staff   StaffProfile @relation("StaffDailyLogs", fields: [staffId], references: [id], onDelete: Cascade)

  /// Local calendar day in Africa/Lagos, stored as YYYY-MM-DD. A date-only
  /// string rather than a DateTime on purpose: "which day was this logged
  /// against" must not shift with the server's timezone.
  day String

  summary  String
  blockers String @default("")
  plan     String @default("")

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([staffId, day])
  @@index([day])
}

// ─── Video production ──────────────────────────────────────────────────────

enum ShootStage {
  REQUESTED
  SCHEDULED
  PREPPED
  FILMED
  EDITING
  PUBLISHED
}

model Shoot {
  id       String @id @default(cuid())
  title    String
  location String

  listingId String?
  listing   Listing? @relation("ListingShoots", fields: [listingId], references: [id], onDelete: SetNull)

  stage          ShootStage @default(REQUESTED)
  scheduledFor   DateTime?
  /// When prep was finished. The Secretary is measured on this landing at
  /// least 24 hours before scheduledFor.
  prepCompleteAt DateTime?

  presenterId String
  presenter   StaffProfile @relation("ShootPresenter", fields: [presenterId], references: [id], onDelete: Cascade)
  secretaryId String
  secretary   StaffProfile @relation("ShootSecretary", fields: [secretaryId], references: [id], onDelete: Cascade)

  reshoot        Boolean   @default(false)
  /// From the platform's own analytics, so it is null until somebody reads it.
  /// Storing 0 would be a claim nobody has checked.
  engagementRate Float?
  publishedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[] @relation("ShootThreads")

  @@index([stage])
  @@index([presenterId])
  @@index([scheduledFor])
}

enum ContentChannel {
  INSTAGRAM
  LINKEDIN
  WHATSAPP
  TIKTOK
  X
}

enum ContentKind {
  GRAPHIC
  CAROUSEL
  POST
  VIDEO
  CAMPAIGN
}

model ContentPiece {
  id      String         @id @default(cuid())
  title   String
  channel ContentChannel
  kind    ContentKind

  publishedAt  DateTime?
  scheduledFor DateTime?

  /// Both null until read from the platform. See Shoot.engagementRate.
  engagementRate Float?
  leadsGenerated Int    @default(0)

  ownerId String
  owner   StaffProfile @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([channel])
  @@index([publishedAt])
}

// ─── Targets ───────────────────────────────────────────────────────────────

enum TargetUnit {
  COUNT
  NAIRA
  PERCENT
}

/// Where a target's actual figure comes from.
///
/// DATABASE means it is derived by a query and nobody can type it. MANUAL
/// means somebody enters it from an external source. The distinction is
/// surfaced in the UI on purpose: a scorecard made mostly of MANUAL rows
/// measures diligence in reporting rather than results.
enum TargetProvenance {
  DATABASE
  MANUAL
}

model StaffTarget {
  id      String       @id @default(cuid())
  staffId String
  staff   StaffProfile @relation("StaffTargets", fields: [staffId], references: [id], onDelete: Cascade)

  label  String
  /// Lower and upper bound of the monthly range from the org document.
  min    Float
  max    Float
  /// Only meaningful when provenance is MANUAL — a DATABASE target's actual
  /// is recomputed on read and this column is ignored.
  actual Float      @default(0)
  unit   TargetUnit @default(COUNT)

  /// True when the number is a limit to stay UNDER (reshoot rate, scheduling
  /// conflicts) rather than a floor to reach. Progress inverts for these.
  ceiling Boolean @default(false)

  provenance TargetProvenance @default(MANUAL)
  /// Names the derivation when provenance is DATABASE, e.g. "verifiedListings".
  metricKey  String?

  /// The month this target applies to, as YYYY-MM. Targets are monthly, and
  /// last month's numbers must stay readable after the new month starts.
  period String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([staffId, period, label])
  @@index([period])
}

// ─── Operations tasks ──────────────────────────────────────────────────────

/// An internal to-do the platform does not know about.
///
/// Deliberately the ONLY hand-creatable item in the operations queue. The
/// other queues that queue renders — KYC review, withdrawal payout, reports,
/// disputes, listing review — are projections of KycSubmission,
/// WithdrawalRequest, Report and JobDisputeMessage. A hand-made row of those
/// kinds would be a task with nothing behind it that somebody could mark
/// resolved without any money moving or any document being checked.
model OpsTask {
  id      String  @id @default(cuid())
  subject String
  urgent  Boolean @default(false)

  assigneeId String?
  assignee   StaffProfile? @relation("OpsTaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  resolved   Boolean   @default(false)
  resolvedAt DateTime?

  createdById String?
  openedAt    DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resolved])
  @@index([assigneeId])
}

// ═══════════════════════════════════════════════════════════════════════════
// AGENT PARTNER PROGRAMME
// ═══════════════════════════════════════════════════════════════════════════
// Realtors who register at /realtors/partners. A partner works WITH
// PropertyLoop on commission rather than for it, which is what separates them
// from StaffProfile.
//
// A partner is a real User with an AgentProfile, not a directory row. That is
// forced by the schema rather than chosen: Listing.agentId is required, so
// without an account a partner could never own or be credited on anything.

enum PartnerStatus {
  /// Registered, nobody has spoken to them yet.
  NEW
  CONTACTED
  /// Identity and credentials checked — eligible for the public directory.
  VERIFIED
  /// Listing or selling.
  ACTIVE
  DORMANT
  /// Failed verification. Kept, never deleted — we need the record of why.
  REJECTED
}

enum PartnerExperience {
  NEW
  ONE_TO_THREE
  THREE_PLUS
}

model AgentPartner {
  id   String @id @default(cuid())
  /// Human-readable partner number shown to them and used as a referral code.
  code String @unique

  userId String @unique
  user   User   @relation("AgentPartner", fields: [userId], references: [id], onDelete: Cascade)

  status         PartnerStatus      @default(NEW)
  experience     PartnerExperience?
  agencyName     String?
  operatingState String?

  /// Who referred them. Self-relation so a referral chain is a query rather
  /// than a spreadsheet somebody maintains by hand.
  referredById String?
  referredBy   AgentPartner?  @relation("PartnerReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals    AgentPartner[] @relation("PartnerReferrals")

  /// The staff member handling them.
  ownerStaffId String?
  ownerStaff   StaffProfile? @relation("PartnerOwner", fields: [ownerStaffId], references: [id], onDelete: SetNull)

  // ─── Payout details ────────────────────────────────────────────────────
  // All optional. The registration form lets a partner skip this whole
  // section, because asking a stranger for their NIN before they have agreed
  // to anything loses most of them. "Registered" and "can be paid" are
  // therefore genuinely different states, and the gap between them is what
  // stalls a first commission.
  passportPhotoUrl   String?
  bankCode           String?
  bankName           String?
  accountNumber      String?
  /// Resolved from Paystack, never typed — a mismatch surfaces at
  /// registration instead of when a transfer bounces.
  accountName        String?
  nin                String?
  tin                String?
  /// Lagos State LIRS Payer ID for individuals; companies give a FIRS TIN.
  payerId            String?
  dateOfBirth        DateTime?
  residentialAddress String?
  residentialState   String?
  /// CAC registration number, for partners registered as a company.
  rcNumber           String?

  registeredAt  DateTime  @default(now())
  lastContactAt DateTime?
  notes         String    @default("")
  updatedAt     DateTime  @updatedAt

  leads       Lead[]              @relation("PartnerLeads")
  commissions PartnerCommission[] @relation("PartnerCommissions")

  @@index([status])
  @@index([ownerStaffId])
  @@index([referredById])
}

enum PartnerCommissionStatus {
  /// Sale recorded against the partner, not yet signed off.
  PENDING
  /// Approved, awaiting transfer.
  APPROVED
  PAID
  REJECTED
}

/// Commission owed to a partner for a buyer they introduced.
///
/// Separate from VendorEarning: that settles a job through escrow, this is a
/// share of a property sale. Kept as its own record so "what do we owe
/// partners" is a query, not a reconstruction from leads and listings.
model PartnerCommission {
  id        String       @id @default(cuid())
  partnerId String
  partner   AgentPartner @relation("PartnerCommissions", fields: [partnerId], references: [id], onDelete: Cascade)

  listingId String?
  listing   Listing? @relation("ListingPartnerCommissions", fields: [listingId], references: [id], onDelete: SetNull)
  /// The introduction this commission is for.
  leadId    String?
  lead      Lead?    @relation("LeadPartnerCommission", fields: [leadId], references: [id], onDelete: SetNull)

  /// Naira. BigInt to match Listing.priceNaira.
  saleValueNaira BigInt
  ratePercent    Float
  amountNaira    BigInt

  status            PartnerCommissionStatus @default(PENDING)
  /// Approval is a separate act from recording, and deliberately a separate
  /// permission — the person who logs a sale should not sign off its payout.
  approvedByStaffId String?
  approvedBy        StaffProfile?           @relation("CommissionApprover", fields: [approvedByStaffId], references: [id], onDelete: SetNull)
  approvedAt        DateTime?
  paidAt            DateTime?
  note              String                  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId])
  @@index([status])
  @@index([listingId])
}
